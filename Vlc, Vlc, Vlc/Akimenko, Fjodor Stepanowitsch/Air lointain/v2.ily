vb = \relative c' {
  \voiceconsts
  \clef "tenor"
  
  r16 g(\p h e h g) r g( h e h g)
  r g( h e h g) r g( h e h g)
  r g( c e c g) r g( c e c g)
  r fis( c' e c fis,) r fis( c' dis c fis,)

  r fis( h dis h fis) r e( h' e h e,)
  r g(\< b e b g) r g( a e' a, g)\!
  r fis( a e' a, fis) r fis( a es' a, fis)
  r fis(\> a d a fis) r d( g d' g, d)\!

  r e(\p g cis g e) r e( g cis g e)
  r fis( a d a fis) r d( fis a fis d)
  r f( gis d' gis, f) r d( f gis\< f d)
  r d( fis! a fis d)\! r fis(\f a d a fis)

  r fis( a dis a fis) r fis( a dis a fis)
  r g?( h e h g) r g( c e c g)
  r g(\dim c es c g) r fis( c' d? c fis,)
  r fis( c' d c fis,) r g( h d h g)

  r h(\mf d g d h) r g( c e c g)
  r gis( c e h gis) r a( c e c a)
  r a(\pp c f c a) r f( b d b f)
  r fis!( b d a fis) r g( b d b g)

  r cis(\f e g e cis) r cis( e a e cis)
  r a( cis e cis a) r a( d a' d, a)
  r cis( e g e cis) r cis( e a e cis)
  r a( cis e cis a) r a( d a' d, a)

  r c!(\p d as' d, c) r h( d g d h)
  r h( c g' c, h) r ais( cis fis cis ais)
  r b( c! ges' c, b) r a!( c f c a)
  r a( h! f' h, a) r gis( h e h gis)
  
  r g!(\cresc b e b g) r g( b e b g)
  r a( c e c a) r a( c fis? c a)
  r a( c dis c a) r a( c fis c a)
  r a(\dim c dis c a) \rit r a( dis fis dis a)

  r g(\p h? e h g) \atm r g( h e h g)
  r g( h e h g) r g( h e h g)
  r g( c e c g) r g( c e c g)
  r fis( c' e c fis,) r fis( c' dis c fis,)

  r fis( h dis h fis) r e(\< h' e h e,)
  r g( b e b g)\! r g( a e' a, g)
  r fis( a e' a, fis) r fis( a es' a, fis)
  r fis(\> a d? a fis) r d( g d' g, d)\!
  r e(\p g cis g e) r e( g cis g e)

  r fis( a d a fis) r d( fis a fis d)
  r f( gis d' gis, f) r d(\< f gis f d)
  r d( fis! a fis d)\! r fis(\f a d a fis)
  r fis( a dis a fis) r fis( a dis a fis)
  r g?( h e h g) r e(\> gis e' a, e)\!

  r f(\p c' f c f,) r f( c' f c f,)
  r a( c f c a) r a( c f c a)
  r f( c' f c f,) r f( c' f c f,)
  r a( dis fis! dis a) r a( dis fis dis a)
  r gis(\f d'! e d gis,) r g( cis e cis g)

  r fis( c'! e c fis,) r fis( c' dis c fis,)
  r gis(\p d'! e d gis,) r g( cis e cis g)
  r fis( c'! e c fis,) r fis( c' dis c fis,)
  r gis(\mf h e h gis) r fisis( cis' e cis fisis,)

  r gis( h e h gis) r fisis( cis' e cis fisis,)
  r gis(\dim h e h gis) r gis( h e h gis) \rtn
  r gis( h e h gis) r a( h fis'? h, a)
  r h( e gis e h) r h( e gis e h)
  <\parenthesize h gis'>2.\fermata\pp \bar "|."
}