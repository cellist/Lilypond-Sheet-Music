vc = \relative c {
  \voiceconsts
  
  \introa
  g4 r8 c g g'16 a h8 g
  a a16 g fis8 d g g,16 a h8 g
  d'4 r8 g, d'4 r8 g,
  d'4 r8 g, d'4 r8 g,
  a4 a a a

  a a a a
  d8 e fis g a g a a,
  d4 r8 a' d d,16 e fis8 d
  a'4 r8 d, a' a, r fis'
  h4 r8 h, e4 r8 e
  a4 r8 a, d4 r8 d
  g4 r8 g, cis4 r8 cis
  fis4 r8 d a'4 ais
  h8 h, d e fis e fis fis,
  
  g a h c? d c d d,
  a' a c a e' e g e
  h h d h e e fis fis
  g g, h g c a d d,
  g4 r g r
  g r g r
  g g'8 fis e2
  d1\fermata  \bar "|."

  \introb
  \repeat volta 2 {
    g,8 h c d
    g g,16 a h8 g
    c h a d g,4 r8 g'
    fis fis fis e16 d
    e4 r8 e
    d d d c16 h
    c4 r8 c
    h h h a16 g
    c4 r8 c
    d4 r
    R2
    r8 d'4 cis8

    d d, g gis
    a a fis fis
    h h e, e
    a a d, d
    g? g cis, cis
    \repeat tremolo 4 d
    cis cis cis h
    a d a' a,
    d fis g a
    h a g fis
    g4 r
    gis r
    a a

    a a
    a d,
    g, a
    d, r
  }
  \repeat volta 2 {
    d'8 fis g a
    d, d16 e fis8 d
    g fis e a,
    d4 r8 d'
    cis cis cis h16 a
    h4 r8 h
    a a a g16 fis
    g4 r8 g
    fis fis fis e16 d
    g4 r8 g,

    \repeat tremolo 4 a
    \repeat tremolo 4 a
    \repeat tremolo 4 a
    \repeat tremolo 4 a
    d d fis fis
    \repeat tremolo 4 g
    \repeat tremolo 4 fis
    \repeat tremolo 4 e
    \repeat tremolo 4 d
    \repeat tremolo 4 a
    \repeat tremolo 4 d

    \repeat tremolo 4 e
    \repeat tremolo 4 fis
    g g g fis
    e e a a
    d, d g g
    c,? c fis fis
    \repeat tremolo 4 g
    fis fis fis e
    d g d' d,
    g h, c d
    e d c h
    c4 r
    cis r
    d d
    d d
    d g,
    c? d
    g, r
  }

  \introc
  e' g h
  e,2 r4
  ais, ais ais
  h2 r4
  h h h
  e2 r4
  e2 r4
  h2 r4
  c2 a?4
  h2 r4
  e e e
  a,2 r4

  d d d
  g,2 r4
  g2 r4
  d'2 dis4
  e2 a,4
  h h'8 a g fis
  e2 r4
  fis2 h,4
  e2 a,4
  h2 r4
  dis dis dis

  e2 r4
  ais, ais ais
  h2 r4
  h h h
  e4. fis8 g4
  a? h h,
  e e e
  r d? d
  r c c
  h2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    g8 d' d,
    g g'16 a h8
    c, d d,
    g g'16 a h8
    c, d d,
    g d''16 c h a
    g8 cis cis,
    fis h h,
    e a a,
    d4 r8
    d g, gis
    a a' g!
    fis e d
    g g, h

    cis e cis
    fis fis, a
    h d h
    e e, g
    a4 r8
    a4 r8
    a a' g
    fis d d'
    d cis h
    r d d,
    a a' g
    fis d d'
    d cis h
    r d d,

    a16 a'( g fis e d)
    cis a'( g fis e d)
    cis4 d8
    g a a,
    d4.
  }
  \repeat volta 2 {
    d8 a' a,
    d d16 e fis8
    g a a,
    d d16 e fis8
    g a a,
    d16 d'( a g fis e)
    d8 d' d

    cis cis cis
    c! c c
    h h h
    h h h
    a a a
    g g gis
    a4 r8
    a4 r8
    a, cis a
    d d'16 c! h a
    g8 g,16 a h c
    d8 d c
    h4 a8
    g a h

    c4 h8
    a h c
    d4 c8
    h c d
    e4 d8
    c a g
    d' d' c
    h a g
    c c, e
    fis a fis
    h h, d
    e g e
    a a, c
    d4 r8
    d4 r8
    d d c

    h g g'
    g fis d
    r g g,
    d' d c
    h g g'
    g fis d
    r g g,
    d'16 d'( c h a g)
    fis d'( a g fis e)
    d4 g8
    c, d d,
    g4.
  }
