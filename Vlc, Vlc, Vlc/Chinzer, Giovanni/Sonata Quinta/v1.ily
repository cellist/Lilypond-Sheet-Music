va = \relative c' {
  \voiceconsts
  \clef "tenor"

  \introa
  d8 g( fis e) \grace e d4 r8 d
  c a16( h c fis a) c, c8\trill h r h
  a d( c h) a cis4 d8
  a d( c! h) a cis4 d8
  e fis4 g fis e16 d
  e8 fis4 g h a16 g
  a8 cis, d g16( e) fis4 e\trill
  d8 h'( a g) \grace g fis4 r8 fis
  e a( g fis) fis e a4~
  a16 g( fis e d e fis a) g2~

  g16 fis( e d cis d e g) fis2~
  fis16 e( d c! h c d fis) e2~
  e8 a, d2 cis4~
  cis8 fis, h2 a4~
  a8 d, g2 fis4
  e a2 g4
  fis h2 a4~

  a g2 fis4\trill
  g8 g'( fis e) d e( d c?)
  h g'( fis e) d e( d c)
  h cis\trill d4 d16 g d h \grace d8 cis4\trill
  d1\fermata \bar "|."

  \introb
  \repeat volta 2 {
    d8 g4 fis8
    \grace fis g4 r8 d
    e d16 e \grace d8 c4
    h8 e e e
    e d16 cis d4~
    d16 e fis g c,!8 c
    c h16 a h4~ h16 c d e a,8 a

    a g16 fis g4~
    g8 e'16( d c h a g)
    fis8 d'4 cis8
    d fis4 e8
    fis a4 a8~
    a h16 a g8 fis
    fis e a4~
    a g~
    g fis~
    fis e d,16( e) e( fis) fis( g) g( a)
    a( h) h( cis) cis( d) d( e)
    e( fis) d( e) \grace d8 cis4\trill
    d8 a' d, d
    \repeat tremolo 4 d
    \repeat tremolo 4 d
    \repeat tremolo 4 d
    cis8. d16 d8. e16
    e8. fis16 fis8. g16

    g8 fis16 e fis8 d
    e d4 cis8
    d4 r
  }
  \repeat volta 2 {
    a8 d4 cis8
    \grace cis d4 r8 a'
    h a16 h \appoggiatura a8 g4
    fis8 h h h
    h a16 gis a4~
    a16 h c? d g,!8 g

    g fis16 e fis4~
    fis16 g a h e,8 e
    e d16 cis d4~
    d8 h'16( a g fis e d)
    cis4 a'8 a
    h32( a g8.) d'32( cis h8.)
    h8 a fis fis
    g32( fis e8.) h'32( a g8.)

    g8 fis r d~
    d h4 e8~
    e a,4 d8~
    d g,4 cis8
    d4 r8 fis
    fis( e) r g
    g( fis) r a
    a( g) r h
    h( a) r c?

    c( h) r a
    g32( fis e8.) c'32( h a8.)
    fis32( e d8.) h'32( a g8.)
    e32( d c8.) e32( d c8.)
    h16( c) c( d) d( e) e( fis)
    fis( g) g( a) a( h) h( c)

    c( d) h( c) \grace h8 a4\trill
    g8 d g, g
    \repeat tremolo 4 g
    \repeat tremolo 4 g
    \repeat tremolo 4 g
    fis8. g16 g8. a16
    a8. h16 h8. c16

    c8 h16 a h8 g
    a g4 fis8
    g4 r
  }

  \introc
  e' h8 a g fis
  g4. fis8 e4
  e' fis g
  fis8 h, c( h) c( h)
  fis'4 g a
  g4. fis8 e4
  r8 g a( g) a( g)
  r fis g( fis) g( fis)

  r e fis( e) fis( e)
  e4\trill dis r
  h'8( e, h') d!( c h)
  c( h) h( a) a4
  a8( d, a') c( h a)
  h( a) a( g) g4
  r8 h c( h) c( h)
  r a h( a) h( a)

  r g a( g) a( g)
  g4\trill fis r
  r8 h, c( h) c( h)
  r a h( a) h( a)
  r g a( g) a( g)
  g4\trill fis r
  \appoggiatura { a16[ h] } c4 h a
  g4. fis8 e4
  \appoggiatura { e'16[ fis] } g4 fis e

  dis4. c8 h4
  \appoggiatura { fis'16[ g] } a4 g fis
  g4. fis8 e4
  c' \grace e,8 dis2\trill
  e4 h h
  r h h
  r a a
  h2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    g'16 a h8 a
    g4 d8
    \tuplet 3/2 8 { e16( fis g) } \grace d8 c4
    \grace c8 h4 d8
    \tuplet 3/2 8 { e16( fis g) d([ c h]) c( h a) }
    \grace a8 h4.
    g'8 \grace fis e4
    a16[ fis d8] \tuplet 3/2 8 { fis16( g a) }
    g8 \grace fis e4

    fis16( e d e fis g)
    a fis g8 fis
    fis\trill e r
    a a8.\trill g32 a
    h4.~
    h16 d( cis h a gis)
    a4.~
    a16 cis( h a g fis)
    g4.~

    g16 h( a g fis e)
    fis a( g fis e d)
    e g( fis e fis g)
    a8 a4\trill
    g8 g4\trill
    fis8 fis4\trill
    e16 g( fis e fis g)
    a4.\trill
    g\trill
    fis\trill

    e4 fis8
    g4.~\trill
    g8 fis16 e fis8
    g \grace fis e4\trill
    d4.
  }
  \repeat volta 2 {
    d16 e fis8 e
    d4 a'8
    h16 d \grace a8 g4
    \grace g8 fis4 a8
    \tuplet 3/2 8 { h16( c? d) a([ g fis]) g( fis e) }

    \grace e8 fis4 r8
    h h h
    h16 gis \grace gis8 a4
    a,8 a' a
    a16 fis \grace fis8 g4
    g,8 g' g
    g16 e \grace e8 fis4
    fis8 e d
    cis16( h a) h cis d
    e( d cis) d e fis

    g8 g g
    g fis r
    h, h h
    h a r
    g d'4~
    d8 f, f
    e16 f g a h8
    c? h4\trill
    a16 c( h a h c)
    d8 c4\trill

    h16 d( c h c d)
    e8 fis? g
    fis16( e d8) r
    d d8.\trill c32 d
    e4.~
    e16 g( fis e d cis)
    d4.~
    d16 fis e d c! h
    c4.~

    c16 e( d c h a)
    h d( c h a g)
    a c( h a h c)
    d8 d4\trill
    c8 c4\trill
    h8 h4\trill
    a16 c( h a h c)
    d4.\trill
    c\trill
    h\trill

    a4 h8
    c4.~\trill
    c8 h16 a h8
    c a4\trill
    g4.
  }
}