vb = \relative c' {
  \voiceconsts

  \introa
  cis8\mf e fis d d cis r cis
  h d4 h8 h a16 h cis4~
  cis8 d16 cis h8 a a gis r gis
  a16( gis) a8 r fis gis16( fis) gis8 r cis
  
  fis,16( a) gis8 cis16( dis) e8 a16( fis) gis8 r fis16 e
  dis8 e4 dis8 e4 r8 cis
  h16( a) h8 r4 a16( gis) a8 r4
  gis16( fis) gis8 r4 fis16( e) fis8 r4
  e16( dis) e8 r a h16( a) h8 r gis

  a16( gis) a8 r e' d? cis16( a) gis8 cis16 e
  d( h) cis( a) h gis a8 gis4 r
  a8 a4 gis8 a4 r
  r8 a' a a a4 gis\fermata \bar "|."

  \introb
  \repeat volta 2 {
    R1*2
    e,4\f e'4. dis16 cis h8 a
    a gis r a gis16 a h cis d!8 d
    d cis r a \repeat tremolo 4 h
    h a r gis a16 gis fis e \grace gis8 fis4

    e8 h' e4~ e8 a, d4~
    d8 cis16 h cis4 cis8 fis, h4~
    h8 a16 gis a8 h cis a h a
    gis4 r r8 e e e
    h'2~ h8 a16 gis a8 h16 cis
    d2~ d8 cis16 h cis8 d16 e
    \repeat tremolo 4 fis8 fis e a4~

    a8 gis16 fis e8 d d cis r d
    cis16 d e fis g8 g g fis e d
    \repeat tremolo 4 e e d r d
    d16 cis h a \grace cis8 h4\trill a r8 e'
    dis16 e fis gis? a8 a a gis r4

    e8 e4 dis16 cis h8 cis4 h16 a
    gis8 a4 gis16 fis e4 dis\trill
    e2 r
  }
  \repeat volta 2 {
    R1*2
    h'4 h'4. ais16 gis fis8 e
    e dis r e dis16 e fis gis a!8 a
    a gis r e \repeat tremolo 4 fis

    fis e a4. gis16 fis e8 d?
    d cis r cis d16 cis h a \grace cis8 h4
    a r8 e' dis16 e fis gis a8 a
    gis h, h h cis2~
    cis8 a'16 gis a cis, h ais h2~
    h8 gis'16 fis gis h, a gis a2~

    a8 fis'16 e fis a, gis fis gis8 e'4 fis16 e
    d? cis h a \grace cis8 h4\trill a a'
    a8 gis16 fis e8 d d cis r e
    dis16 e fis gis a8 a a gis r e
    \repeat tremolo 4 fis fis e r cis
    d16 cis h a \grace cis8 h4 a r8 a'

    \repeat tremolo 4 h h a r fis
    \repeat tremolo 4 g g fis a4~
    a8 fis g fis e4 r
    cis8 a'4 gis!16 fis e8 fis4 e16 d
    cis8 d4 cis16 h a4 gis\trill
    a2 r
  }
  
  \introc
  r4 fis'\mf fis
  g8 a h4 g
  g fis r
  e8. d16 e8. e16 fis8. e16
  d8. cis16 d8. d16 e8. d16
  d4 cis8. d16 e4~
  e d8. e16 fis4
  g h, h
  a a a

  h e8 d e cis
  d4 cis r
  d, h'2~
  h4 e,2~
  e4 cis'2~
  cis4 fis,2~
  fis4 d'2~
  d4 g,2~
  g4 e'2~
  e4 a,2~
  a8 h' a g fis e

  d4 d cis
  d r2
  r4 h'8 a g fis
  e2.~
  e2 fis4~
  fis e2
  d2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    a8\f cis h
    cis4 a16 h
    cis8 d cis
    \grace cis h4 a8
    a d d
    d cis16 h cis8
    h h h
    h a16 gis a8
    a fis'16 e d cis
    h8 cis d~

    d e16 d cis h
    cis8 d e~
    e fis16 e d cis
    gis8 a h~
    h cis16 h a gis
    a8 cis fis~
    fis h, e~
    e a, d~
    d gis, cis~
    cis fis, h

    gis e a~
    a a gis
    a4 r8
    r16 a'( gis fis e d)
    cis fis( e d cis h)
    a a'( gis fis e d)
    cis8 d h
    a4 r8
  }
  \repeat volta 2 {
    a cis h

    cis4 a16 h
    cis d e8 e
    e d16 cis d8
    dis dis cis
    dis4 h16 cis
    dis e fis8 fis
    fis e16 dis e8
    cis16( h) cis8 d!
    h16( a) h8 cis

    a16( gis) a8 h
    \grace a gis4.
    cis16\p h cis8 d
    h16( a) h8 cis
    a16 gis a8 h
    \grace a gis4 r8
    R4.*3
    r8 e'\f e
    dis e fis~
    fis gis16 fis e dis

    e h( cis h cis) gis
    fis a( h a h) fis
    e gis( a gis a) e
    dis fis( gis fis gis) dis
    e cis' fis e dis cis
    c8 gis cis~

    cis cis c
    cis!16 fis e d cis h
    ais8 ais ais
    h16 e d cis h a!
    gis8 gis gis
    a4 r8
    r16 a'( gis fis e d)
    cis fis( e d cis h)

    a a'( gis fis e d)
    cis8 d h
    a4\parenthesize\fermata r8
  }
}