va = \relative c' {
  \voiceconsts
  \clef "tenor"

  \introa
  e8\mf a4 fis8 fis e r e
  d h'4 d,8 d cis16 d e4~
  e8 fis16 e d8 cis cis h r h

  cis16( h) cis8 r dis e16( dis) e8 r fis16 e
  dis( fis) e8 a gis cis16( a) h8 r a
  a16 fis gis a \grace gis8 fis4\trill e r8 e
  d?16( cis) d8 r4 cis16( h) cis8 r4
  h16( a) h8 r4 a16( gis) a8 r4

  gis16( fis) gis8 r cis d16( cis) d8 r h
  cis16( h) cis8 r a h16( gis) a( cis) d( h) cis( a)
  h e, cis' e, d' e, cis' e, h'8 d gis \tuplet 6/4 8 { h32( a gis fis e d) }

  cis16 a' a, d cis8 h\trill a a' a a
  a dis, dis dis e2\fermata \bar "|."

  \introb
  \repeat volta 2 {
    a,4\f a'4. gis16 fis e8 d
    d cis r e dis16 e fis gis a8 a
    a gis r e \repeat tremolo 4 fis
    fis e r cis d16 cis h a \grace cis8 h4\trill
    a8 e' a4. gis16 fis e8 d

    d cis r e dis16 e fis gis a8 a
    a gis r e \repeat tremolo 4 fis
    fis e r cis \repeat tremolo 4 d?
    d cis e4. cis8 d cis
    h gis gis gis a2~

    a8 gis16 fis gis8 a16 h cis2~
    cis8 h16 a h8 cis16 d e2~
    e8 d16 cis d8 d d cis16 h cis8 a'
    \repeat tremolo 4 h h a r fis

    g16 fis e d \grace fis8 e4\trill d d'~
    d8 cis16 h a8 g g fis r a
    gis?16 a h cis d8 d d cis r h
    a16 gis fis e \grace gis8 fis4\trill e8 e4 dis16 cis
    h8 cis4 h16 a gis8 e'4 dis16 cis
    h8 cis4 h16 a gis4 fis\trill
    e2 r
  }
  \repeat volta 2 {
    e4 e'4. dis16 cis h8 a
    a gis r h ais16 h cis dis e8 e
    e dis r h \repeat tremolo 4 cis

    cis h r gis a?16 gis fis e \grace gis8 fis4\trill
    e e'4. dis16 cis h8 a
    a gis r a \repeat tremolo 4 h
    h a r a gis16 a h cis d8 d
    d cis r gis a16 gis fis e \grace gis8 fis4\trill
    
    e r r8 e' e e
    fis2~ fis8 d'16 cis d fis, e dis
    e2~ e8 cis'16 h cis e, d! cis
    d2~ d8 cis16 h cis8 a
    gis16 a h cis d8 d d cis r a

    \repeat tremolo 4 h h a r h
    a16 gis fis e \grace gis8 fis4\trill e e'~
    e8 dis16 cis h8 a a gis r a
    gis16 a h cis d!8 d cis e a4~
    a8 d, g4~ g8 fis16 e fis4~
    fis8 h, e4~ e8 d16 cis d8 e
    fis d e d cis a'4 gis?16 fis
    e8 fis4 e16 d cis8 a'4 gis16 fis
    e8 fis4 e16 d cis4 h\trill
    a2 r
  }
  
  \introc
  r4 a'\mf a
  h8 cis d4 h
  a g r
  g8. fis16 g8. g16 a8. g16
  fis8. e16 fis8. fis16 g8. fis16
  fis4 e8. fis16 g4~
  g fis8. g16 a4

  \tuplet 3/2 4 { h8( g fis) } dis4 e
  \tuplet 3/2 4 { a8( g fis) } cis4 d!
  \tuplet 3/2 4 { g8( a h) } a4 g
  fis e a,
  h dis e~
  e8 d! cis4 h
  cis eis fis~

  fis8 e! d4 cis
  d fis g~
  g8 fis e4 d
  e gis a~
  a8 g! fis4 e
  fis4. g8 a4~
  a8 h \grace fis e2\trill
  d4 a'8 g fis e

  d2.~
  d2 cis4
  \grace d8 cis2 d4~
  d8 h d4 cis
  d2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    e8\f a gis
    a8 a,16 h cis d
    e8 fis e
    \grace e d4 cis8
    fis fis fis
    fis e16 dis e8
    d! d d
    d cis16 h cis8
    fis16 e d cis h a

    gis8 a h~
    h cis16 h a gis
    a8 h cis~
    cis d16 cis h a
    h8 cis d~
    d e16 d cis h
    cis e( fis e fis) cis
    h dis( e dis e) h

    a cis( d! cis d) a
    gis h( cis h cis) gis
    fis a( h a h) fis
    e8 gis e'
    fis \grace cis h4\trill
    a16 a'( gis fis e d)
    cis fis( e d cis h)

    a a'( gis fis e d)
    cis fis( e d cis h)
    a8 h gis
    a4 r8
  }
  \repeat volta 2 {
    e' a gis
    a a,16 h cis d
    e fis g8 g
    g fis16 e fis8

    fis h ais
    h h,16 cis dis e
    fis gis? a8 a
    a gis16 fis gis8
    e16( d) e8 fis
    d16( cis) d8 e
    cis16( h) cis8 d
    \grace cis h4.

    e16(\p d) e8 fis
    d16( cis) d8 e
    cis16( h) cis8 d
    h e\f e
    dis e fis~
    fis gis16 fis e dis
    e8 fis gis~
    gis a16 gis fis e

    fis8 gis a~
    a h16 a gis fis
    gis8 e cis'~
    cis fis, h~
    h e, a~
    a dis, gis~
    gis cis, fis~
    fis4 e8~
    e16 fis dis4\trill

    cis8 cis16 d! e8~
    e16 g fis e d cis
    d cis h cis d8~
    d16 fis( e d cis h)
    cis a'( gis? fis e d)
    cis fis( e d cis h)
    a a'( gis fis e d)

    cis fis( e d cis h)
    a8 h gis
    a4\parenthesize\fermata r8
  }
}