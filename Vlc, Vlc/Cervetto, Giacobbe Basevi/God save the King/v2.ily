vb = \relative c, {
  \voiceconsts

  \repeat volta 2 {
    f8 e f g a b
    c h c d e c
    f e f c g' c,
    f e f c d a
    b? g c b c c,
    f a c f f,4
  }

  \repeat volta 2 {
    a8 b c b a g

    fis e d e fis d
    g a b a g f!
    e d c d e c
    f e16 f g8 f e d
    c c'16 d c8 b a f
    b g c b c c,
    f a c f f,4
  }
}