vb = \relative c' {
  \voiceconsts

  \repeat volta 2 {
    e4\mf\< e e\!
    e2\> d4\!
    f\< f f\!
    f2\> e4\!

    c'\< c c
    c2 d4\!
    e\> d c
    c2 h4\!
  }

  \repeat volta 2 {
    h\< h cis\!
    cis2\> d4\!
    a\< a h\!
    h2\> c?4\!

    e,\< e e
    e2 f4\!
    g2\> f4\! \fine
    e r2
  }

  \repeat volta 2 {
    f'8\p e \trio d c h a
    g4\< a h\!
    R2.*2

    f'4\mf e8 g e c
    R2.
    f8\< c e c f c\!
    f2\> e4\!
  }

  \repeat volta 2 {
    R2.
    r8 c,\p r c r c
    r c r c r c
    r c r c r c

    r c r c r c
    c' a f a c a
    h g a f g e \dcim
    <c f>2 r4
  }
}