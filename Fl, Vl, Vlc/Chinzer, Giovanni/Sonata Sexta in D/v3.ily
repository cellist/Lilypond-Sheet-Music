vc = \relative c' {
  \voiceconsts
  \clef "bass"
  
  \introa
  d8 d cis cis h h fis fis
  g g a a d,4 r8 e
  fis4 g8 gis a a fis d

  \repeat tremolo 4 g, \repeat tremolo 4 a
  \repeat tremolo 4 h \repeat tremolo 4 cis
  d4 r d r
  d8 e fis d g? g e e
  cis cis d d h h cis cis
  a a h h g g a a

  d h h h a h cis a
  \repeat tremolo 4 d gis, gis a a
  d2\fermata r \bar "|."

  \introb
  \repeat volta 2 {
    \partial 8 r8
    d8 g fis e d g fis e
    d a' d,16 e fis g a8 a, cis a
    e' e, e e a a cis a
    e' e, e e a a cis a
    d4 r r2

    R1
    r4 a e' e
    e e e e
    e e e e
    a, a d g
    fis e d g
    fis e d d
    cis h a d
    cis h a r

    a r a r
    a8 a16 h cis8 d e4 e,
    a' e a, r8
  }
  \repeat volta 2 {
    r
    a d cis h a d cis h
    a e a16 h cis d e8 d cis ais

    h e d cis h e d cis
    h fis h16 cis d e fis8 fis d h
    e e ais, ais h h d h
    cis cis fis fis h, h' h h,
    e fis g e
    h cis d h

    cis h ais fis h cis d e
    fis e fis fis, h4 r8 fis'
    g g a? a d, e fis d
    e e a a d, e fis d
    cis a a cis h h e e,

    a4 r r2
    a4 r r2
    d8 d' g, a d,4 r
    d r d r
    d8 d16 e fis8 g a4 a,
    \partial 2.. d' a d, r8
  }

  \introc
  h4 h h
  h ais r
  ais h eis
  fis fis, fis
  h h h
  e? e e
  a,? a a
  d d d
  e e e
  fis fis' e

  fis, fis' d
  fis, g' e
  fis, g' e
  fis, d' h
  fis d' h
  e, fis g
  eis fis fis,
  h2.
  g4 g g
  fis2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    \partial 8 r8
    d'8 e fis d
    g d r a
    d fis g a
    d, d' d,4
    R2
    r8 d' d,4
    R2
    r8 a' g g
    fis g fis e
    d e fis d
    g a g fis

    e e, fis g
    \repeat tremolo 4 a
    \repeat tremolo 4 a
    \repeat tremolo 4 a
    \repeat tremolo 4 a
    \repeat tremolo 4 a
    d g fis e
    d e fis d
    g a h g
    cis, d e cis
    fis g a fis

    h, cis d h
    e fis g e
    a, h cis a
    d4 r8 a'
    d,4 r8 a
    d4 r8 a'
    d, e fis g
    a g a a,
    d4 r8
  }
  \repeat volta 2 {
    r
    h cis d h
    e h r fis

    h d e fis
    h, h' h,4
    R2
    r8 h' h,4
    R2
    r8 fis' fis, fis
    h g' g e
    d d d h
    a a' a fis
    e e e cis
    h h' h gis
    \repeat tremolo 4 fis

    gis gis ais ais
    h h d, d
    \repeat tremolo 4 e
    \repeat tremolo 4 fis
    \repeat tremolo 4 fis
    \repeat tremolo 4 fis
    \repeat tremolo 4 fis
    \repeat tremolo 4 fis
    h, cis d e
    fis e fis fis,

    h4 r8 h
    h cis dis h
    e4 r8 e
    e fis gis e
    a?4 r8 a,
    a h cis a
    d? g? fis e
    d e fis d
    g a h g
    cis, d e cis
    fis g a fis

    h, cis d h
    e fis g e
    a, h cis a
    d4 r8 a'
    d,4 r8 a
    d4 r8 a'
    d, e fis g
    a g a a,
    d4 r8
  }
}