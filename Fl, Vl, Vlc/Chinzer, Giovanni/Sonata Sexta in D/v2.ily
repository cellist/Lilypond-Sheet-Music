vb = \relative c'' {
  \voiceconsts

  \introa
  r2 d8 d~ \tuplet 3/2 8 { d16 a'( g fis[ g a]) }
  d,8 d cis cis d4 r8 d~
  d g16 fis e8 d d\trill cis r a
  h4~ \tuplet 3/2 8 { h16 g( a h[ a g]) } cis4~ \tuplet 3/2 8 { cis16 a( h cis[ h a]) }

  d4~ \tuplet 3/2 8 { d16 h( cis d[ cis h]) } e4~ \tuplet 3/2 8 { e16 cis( d e[ d cis]) }
  fis16. g32 g16. fis32 fis16. e32 e16. d32 d16. g32 g16. fis32 fis16. e32 e16. d32
  d4 r8 fis h4~ \tuplet 3/2 8 { h16 cis,( d e[ fis g]) }
  a4~ \tuplet 3/2 8 { a16 h,( cis d[ e fis]) } g4~ \tuplet 3/2 8 { g16 a,( h cis[ d e]) }

  fis4~ \tuplet 3/2 8 { fis16 g,( a h[ cis d]) } e4~\tuplet 3/2 8 { e16 fis,( g a[ h cis]) }
  fis,8 d' d d cis d e d16 cis
  \repeat tremolo 4 d8 d d cis cis
  d2\fermata r \bar "|."

  \introb
  \repeat volta 2 {
    \partial 8 r8 r4. a8 d( h' a cis,)
    d cis d4 cis r8 cis
    \tuplet 3/2 8 { h16( a gis) } gis4 h8 a4 r8 cis
    \tuplet 3/2 8 { h16( a gis) } gis4 h8 a4 r
    r4. e'8 fis( d) e( cis)

    d( h) cis( e) fis16( e d) e e( d cis) e
    d( cis h) cis cis( h a) cis h8 d( cis h)
    cis16( d e8) d cis gis16( a h8) a gis
    a16( h cis8) h a h16( cis d8) cis h
    cis16( d e8) d cis d2~

    d1~
    d2 d8 fis4 e8~
    e d4 cis16 h cis8 fis4 e8~
    e d4 cis16 h cis a' gis fis e8 d
    cis16 fis e d cis8 h a16 a' gis fis e8 d
    cis4 r8 a a4 gis\trill
    a gis a r8
  }
  \repeat volta 2 {
    r8
    r4. e8 a( fis' e) gis,
    a gis a4 gis r
    r4. fis8 g g'! fis ais,
    h ais h4 ais r8 d
    \tuplet 3/2 8 { e16( d cis) } cis4 e8 \tuplet 3/2 8 { d16( cis h) } h4 d8
    \tuplet 3/2 8 { cis16( h ais) } ais4 cis8 h4 r8 d

    g h4 g8 fis ais, h fis'
    e gis, ais e' d e fis g
    cis,2 h4 r8 a'
    \tuplet 3/2 8 { g16( fis e) } e4 g8 \tuplet 3/2 8 { fis16( e d) } d4 fis8
    \tuplet 3/2 8 { e16( d cis) } cis4 e8 d4 r8 a'?
    a2. gis4

    a4 r r8 e fis( d)
    e( cis) d( h) cis( a') h( g)
    a( fis) g( e) fis4 r
    d16 d' cis h a8 g fis16 h a g fis8 e
    d4 r8 d d4 cis\trill
    \partial 2.. d cis d r8
  }

  \introc
  d8. fis16 e4 d
  d cis r
  cis h8. ais16 h4
  h ais r
  r2 h'4~
  h8 a? g( fis e d)
  cis4 e a~
  a8 g fis( e d cis)
  h4 a g
  \grace g8 fis4 r2
  
  d'8. e16 d8. e16 d8. e16
  cis4 r2
  cis8. d16 cis8. d16 cis8. d16
  h4 r2
  h8. cis16 h8. cis16 h8. cis16
  g4 fis e
  d d' cis
  h2.
  h4 h h
  ais2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    \partial 8 d8
    \repeat tremolo 4 fis
    g fis4 e8
    d a g e
    fis4 r8 fis'
    g( fis) fis( e)
    e( d) r fis
    fis( e) e( d)
    d cis r4
    R2*2
    e4 h'~
    h8 d, d d
    cis4 r

    r8 a' a, h
    cis a16 h cis8 d
    e cis16 d e8 fis
    g e16 fis g8 e
    fis4 r
    r8 d d d
    h'2~\startTrillSpan
    h8\stopTrillSpan cis, cis cis
    a'2~\startTrillSpan
    a8\stopTrillSpan h, h h
    g'2~\startTrillSpan
    g8\stopTrillSpan a, a a

    fis' e16 fis g8 e
    fis g( fis e)
    d cis16 d e8 cis
    d4 r8 d
    d4 cis\trill
    d4 r8
  }
  \repeat volta 2 {
    h
    \repeat tremolo 4 d
    e d4 cis8
    h fis' e cis
    d4 r8 d

    e( d) d( cis)
    cis( h) r d
    d cis cis h
    h ais r4
    r4. cis8
    d2~
    d8 cis16 h cis8 dis
    e2~
    e8 dis16 cis dis8 eis
    fis4 r8 ais,
    h h cis cis

    fis, h h h
    \repeat tremolo 4 g
    fis4 r
    r8 fis' fis, gis
    ais fis16 gis ais8 h
    cis ais16 h cis8 d?
    e? cis16 d e8 cis
    d4 r8 h
    h4 ais
    h r8 dis

    dis e fis e16 dis
    e8 h e4~
    e8 d? d cis16 h
    cis4 r8 cis
    cis d e d16 cis
    d4 r
    r8 d d d
    h'2\startTrillSpan
    h8\stopTrillSpan cis, cis cis
    a'?2~\startTrillSpan
    a8\stopTrillSpan h, h h

    g'?2~\startTrillSpan
    g8\stopTrillSpan a, a a
    fis' e16 fis g8 e
    d g( fis e)
    d cis16 d e8 cis
    d4 r8 d
    d4 cis\trill
    d4 r8
  }
}