va = \relative c'' {
  \voiceconsts

  \introa
  d8 d~ \tuplet 3/2 8 { d16 a'( g fis[ g a]) } \repeat tremolo 4 d,8
  e e~ \tuplet 3/2 8 { e16 g( fis e[ fis g]) } fis8 d a'4~

  a8 h16 a g8 fis fis\trill e r4
  r8 d\trill e4~ \tuplet 3/2 8 { e16 cis( d e[ d cis]) } fis4~
  \tuplet 3/2 8 { fis16 d( e fis[ e d]) } g4~ \tuplet 3/2 8 { g16 e( fis g[ fis e]) } a4~
  a16. h32 h16. a32 a16. g32 g16. fis32 fis16. h32 h16. a32 a16. g32 g16. fis32
  fis8 g\trill a4~ \tuplet 3/2 8 { a16 h,( cis d[ e fis]) } g4~
  \tuplet 3/2 8 { g16 a,( h cis[ d e]) } fis4~ \tuplet 3/2 8 { fis16 g,( a h[ cis d]) } e4~
  \tuplet 3/2 8 { e16 fis,( g a[ h cis]) } d4~ \tuplet 3/2 8 { d16 e,( fis g[ a h]) } cis4\trill

  d8 gis gis gis a g4 fis16 e
  \repeat tremolo 4 fis8 \repeat tremolo 4 e
  d2\fermata r \bar "|."

  \introb
  \repeat volta 2 {
    \partial 8 a8
    d( h' a cis,) \grace cis d4 r8 e
    fis e16 a \grace g8 fis4 e r8 e
    \tuplet 3/2 8 { d16( cis h) } h4 d8 \tuplet 3/2 8 { cis16( h a) } a4 e'8
    \tuplet 3/2 8 { d16( cis h) } h4 d8  \tuplet 3/2 8 { cis16( h a) } a4 e'8

    fis( d) e( cis) d( h) cis( e)
    fis16( e d) e e( d cis) e d( cis h) cis cis( h a) cis
    h( a gis) a a( gis fis) a gis8 h( a gis)

    a16( h cis8) h a h16( cis d8) cis h
    cis16( d e8) d cis d16( e fis8) e d
    e16( fis g?8) fis e fis h4 a8~

    a g4 fis16 e fis8 h4 a8~
    a g4 fis16 e fis4 a
    a1~
    a2. r4
    r16 a gis fis e8 d cis16 fis e d cis8 h

    a16 h cis d e8 a cis,4 h\trill
    a h cis r8
  }
  \repeat volta 2 {
    e,8
    a fis'( e) gis, \grace gis a4 r8 h
    cis h16 e \grace d8 cis4 h r8 fis
    h g'? fis ais, \grace ais h4 r8 cis
    d cis16 fis \grace e8 d4 cis r8 fis
    \tuplet 3/2 8 { g16( fis e) } e4 g8 \tuplet 3/2 8 { fis16( e d) } d4 fis8
    \tuplet 3/2 8 { e16( d cis) } cis4 e8 \tuplet 3/2 8 { d16( cis h) } h4 fis'8
    fis4 e2 d4~
    d cis2 h4~

    h ais h8 cis d4~
    d cis d r8 a'!
    \tuplet 3/2 8 { g16( fis e) } e4 g8 \tuplet 3/2 8 { fis16( e d) } d4 fis8
    \tuplet 3/2 8 { e16( d cis) } cis4 e8  \tuplet 3/2 8 { d16( cis h) } h4 d8
    cis8( e) fis( d) e( cis) d( h)

    cis( a') h( g) a( fis) g( e)
    fis( d) e( cis) d16 d' cis h a8 g
    fis16 h a g fis8 e d16 d' cis h a8 g

    fis16 e fis g a8 d fis,4 e\trill
    \partial 2.. d4 e fis r8
  }

  \introc
  fis8. a16 g4 fis
  eis fis r
  e! d8 cis d4
  d cis fis~
  fis8 e d( cis h a)
  g4 h e~
  e8 d cis( h a g)

  fis4 a d~
  d cis h
  \grace h8 ais4 r2
  fis'8. g16 fis8. g16 fis8. g16
  e4 r2
  e8. fis16 e8. fis16 e8. fis16
  d4 r2

  d8. e16 d8. e16 d8. e16
  c4 h8 ais h4~
  h h ais
  h2.
  eis,4 eis eis
  fis2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    \partial 8 d'8
    \repeat tremolo 4 a'
    h a4 g8
    fis e16 d e8 d16 cis
    \grace cis8 d4 r8 h'
    h( a) a( g)
    g( fis) r a
    a( g) g( fis)

    fis( e) r4
    d a'~
    a8 c, c c
    h cis!16 d e8 fis
    g4 fis
    e8 a a, h
    cis a16 h cis8 d
    e cis16 d e8 fis

    g e16 fis g8 a
    h g16 a h8 cis
    d d, d d
    a'2~\startTrillSpan
    a8\stopTrillSpan d, d d
    g2~\startTrillSpan
    g8\stopTrillSpan cis, cis cis
    fis2~\startTrillSpan
    fis8\stopTrillSpan h, h h

    e2\trill
    d8 cis16 d e8 cis
    d h'( a g)
    fis e16 fis g8 e
    fis16 d' cis h
    a8 g
    fis4 e\trill
    d r8
  }
  \repeat volta 2 {
    h
    \repeat tremolo 4 fis'

    g fis4 e8
    d cis16 h cis8 h16 ais
    \grace a!8 h4 r8 g'
    g( fis) fis( e)
    e( d) r fis
    fis( e) e( d)
    d( cis) r fis,
    g2~
    g8 fis16 e fis8 gis

    a2~
    a8 gis16 fis gis8 ais
    h2~
    h8 ais16 gis ais8 fis'
    fis e e e
    e d d d
    d c c h
    ais fis' fis, gis
    ais fis16 gis ais8 h

    cis? ais16 h cis8 d
    e cis16 d e8 fis
    g? e16 fis g8 ais
    h a!16 g fis8 e
    d4 cis\trill
    h8 fis' h4~
    h8 a a g16 fis
    g4 r8 gis

    g! a h gis
    a e a4~
    a8 g! g fis16 e
    fis8 d d d
    a'2~\startTrillSpan
    a8\stopTrillSpan d, d d
    g2~\startTrillSpan
    g8\stopTrillSpan cis, cis cis
    fis2~\startTrillSpan
    fis8\stopTrillSpan h, h h

    e2(\trill
    d8) cis16 d e8 cis
    d h'( a g)
    fis e16 fis g8 e
    fis16 d' cis h a8 g
    fis4 e\trill
    d r8
  }
}