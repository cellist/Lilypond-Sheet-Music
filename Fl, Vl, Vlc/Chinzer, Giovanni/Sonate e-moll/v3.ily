vc = \relative c {
  \voiceconsts
  \clef "bass"
  
  \introa
  \repeat tremolo 6 e8
  \repeat tremolo 6 h
  \repeat tremolo 6 dis
  e e  \repeat tremolo 4 ais,
  \repeat tremolo 6 h
  \repeat tremolo 6 c

  \repeat tremolo 6 h
  \repeat tremolo 6 e
  \repeat tremolo 6 a,?
  \repeat tremolo 6 dis
  \repeat tremolo 6 e
  \repeat tremolo 6 c
  \repeat tremolo 6 h
  e e \repeat tremolo 4 ais,
  \repeat tremolo 4 h dis dis

  e e  \repeat tremolo 4 fis
  \repeat tremolo 4 h, eis eis
  fis fis ais ais fis fis
  \repeat tremolo 6 g
  \repeat tremolo 6 a?
  \repeat tremolo 6 d,?
  \repeat tremolo 6 g
  \repeat tremolo 6 c,

  \repeat tremolo 6 fis
  \repeat tremolo 6 h,
  \repeat tremolo 6 e
  \repeat tremolo 6 ais,
  \repeat tremolo 6 h
  \repeat tremolo 6 h
  \repeat tremolo 6 h
  \repeat tremolo 6 h

  a?2.\fermata
  \repeat tremolo 6 ais8
  \repeat tremolo 6 h
  \repeat tremolo 6 h
  e2.
  c
  h\fermata \bar "|."

  \introb
  \repeat volta 2 {
    \partial 8 r8
    e, e' dis h g4 r8 h
    e g fis d h4 r8 d
    g g, g g d'4 dis
    e a,8 ais h h' h h,
    h h' h h, h h' h h,
    h h' h h, e4 r8 e
    fis4 r8 fis g4 r8 g

    a4 r8 a h4 r8 h
    c4 r8 c d4 r8 h
    c4 r8 c, d g, d' d,
    g g' g g \repeat tremolo 4 fis
    g g c, c cis dis dis dis
    \repeat tremolo 4 e fis d g cis,

    fis h, fis' fis, h4 r8
  }
  \repeat volta 2 {
    r
    h h' ais fis d4 r8 fis
    h, d' cis a fis4 r8 a
    \repeat tremolo 4 d, a'4 ais
    h e,8 eis \repeat tremolo 4 fis
    \repeat tremolo 4 fis \repeat tremolo 4 fis

    \repeat tremolo 4 fis h, h' h h
    \repeat tremolo 4 a \repeat tremolo 4 g
    \repeat tremolo 4 fis \repeat tremolo 4 e
    d fis g c, d c d d,
    g g' fis d h g' fis h
    e, e dis h g e' dis h

    e g fis d! h4 r8 d
    g, g' g g d4 dis
    e a,8 ais h h' h h,
    h h' h h, h h' h h,
    h h' h h, h g' cis, fis
    \partial 2.. h,[ e h' h,] e4 r8
  }

  \introc
  c4 h c
  d g, r
  c f fis
  g g, r
  g' fis g
  a d, r
  g c, cis
  d d' c!
  h h, g
  c c' c
  c cis, a

  d d e
  c? d d,
  g r2
  gis4 gis gis
  a c a
  d e e,
  a a a
  h h h
  c c c
  d2 e4
  f2.

  e8 f e d c h
  a4 r a
  d8 e d c h a
  g?4 r g
  c8 h c d e4
  f g g,
  c c' c
  r h c
  r c, c
  r g' c, \bar "|."

  \introd
  \repeat volta 2 {
    e h
    e h
    e8 e h' h,
    e4 r
    g, d'
    g, d'
    g,8 g d' d,
    g4 r
    g'8 g, g g
    d' d' g,4
    d g8 g,
    d' d' g,4
    d d'8 c

    h a g g,
    d'4 d'8 c
    h a g g,
    d'4 r
    d r
    d r
    dis r
    e r
    h h'8 a16 g
    fis4 e
    h' g8 e
    h4 e
    h' g8 e
    h h' g a
    h4 h,
    e r

    e r
    fis8 ais h h,
    fis' fis, h4
    fis'8 fis, h4
    fis'8 fis, h4
    cis8 fis h h,
    e4 fis
    h, r8 h
    e4 fis
    h,2
    
  }
  \repeat volta 2 {
    h4 fis'
    h, fis'
    h,8 h fis' fis,
    h4 r
    d? a?
    d a

    d8 d a' a,
    d4 r
    g, d'
    g, d'
    g,8 g d' d,
    g4 r
    g'8 g, g g
    d' d' g,4
    d8 d' g,4
    d8 d' g,4
    a8 d, g g,
    c4 d
    g, r
    gis r
    g! r

    g r
    g g
    a8 h c d
    e4 e,
    a r
    a r
    h8 dis e e,
    h' h' e,4
    h8 h' e,4
    h8 h' e,4
    fis8 h, e e,
    a4 h
    e r8 g
    a4 h
    e,2
  }
}