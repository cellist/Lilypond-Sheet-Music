vc = \relative c {
  \voiceconsts
  \clef "bass"
  
  \introa
  d2 d4
  a' a,8. a'16 e8. cis16
  a2 a'4
  d d,8. d'16 a8. fis16
  d2 d4
  a cis a
  h e8. fis16 gis8. e16

  a4 a,8. a'16 e8. cis16
  a2 a'4
  d d,8. d'16 a8. fis16
  d2 d4
  e2 fis4
  d e e,
  a a' g?
  fis4. fis8 d fis
  g4 h8. a16 g4
  gis4. gis8 e gis

  a4 cis, d
  a a' g?
  fis8. g16 a4 a,
  d2 d4
  cis2 cis4
  h2 h4
  a2.\fermata \bar "|."

  \introb
  \repeat volta 2 {
    d4 a' d, h'
    g a d, h
    g a d r
    r d'2 cis4
    d r8 d, a'4 a,
    d r8 d a'4 a,
    d r g, a
    d r g cis
    fis, h e, a

    d, g a r8 fis16 e
    d4 d g, r8 gis'16 fis
    e4 e a, r8 ais'16 gis
    fis4 fis h, r8 h'16 a!
    g?4 g cis, r8 cis'16 h a4 a d, d
    e e a e

    a, e' a, fis'
    d e a, fis'
    d e a, r
  }
  \repeat volta 2 {
    a e' a, fis'
    d e a, fis'
    d e a, r
    r a'2 gis4
    a r8 a, e'4 e,
    a r8 a e'4 e,

    a r ais ais
    h r e r
    a,? r d r
    g, r cis r8 cis16 h
    ais8 fis' h e, fis e fis fis,
    h4 r e8 e e e
    a,4 r d8 d d d
    
    g, g' a h c g a h
    c4 fis, h e,
    a d, g, g'
    a a, d a
    d a d h'
    g a d, h
    g a d, r
  }

  \introc
  h'4. fis'8 h h,16 cis d8 h
  e4 eis fis8 fis,16 gis ais8 fis
  h a! g! dis' e ais,16 h cis8 ais
  h e fis fis, h h'16 cis d!8 cis

  h4 r8 h, cis cis' cis h
  ais4. fis8 h h, h cis
  d4. e8 fis fis d h
  e fis g ais h cis d h
  cis h ais fis h,4. h8
  e4. e8 ais,4. ais8
  h4. h8 e4. eis8
  fis4. fis8 g4. e!8

  fis g e fis h, h' h h
  eis, eis eis eis fis4 r8 fis

  g g g g gis4. gis8
  fis2 r \bar "|."

  \introd
  \repeat volta 2 {
    \repeat tremolo 4 d8
    \repeat tremolo 4 cis
    \repeat tremolo 4 h
    a a' fis d
    r g e cis
    r fis d h
    r e cis a
    d4 g,
    a r
    d g,
    a r8 fis''
    d8 h r e
    cis a r d

    h g r cis
    a fis r h
    gis e a d,
    e d e e,
    a cis d e
    fis e d cis
    d cis h a
    fis' e d cis
    d cis h a
    e'4 e
    e e
    e e
    e e
    e e

    a, r8 a'~
    a gis16 fis gis8 a~
    a gis16 fis gis8 e
    a fis d e
    a,4 r
  }
  \repeat volta 2 {
    \repeat tremolo 4 a'8
    \repeat tremolo 4 gis
    \repeat tremolo 4 fis
    e e16 d cis8 ais
    h h' h h
    \repeat tremolo 4 ais

    \repeat tremolo 4 gis
    fis fis d h
    r e cis a
    r d h g
    r cis ais fis
    h4 e
    fis r
    h, e
    fis r8 fis
    gis4 ais
    h8 fis h4~
    h a!
    g?2
    fis4 g8 e

    fis e fis fis,
    h4 r8 d'
    h8 g r cis
    a fis r h
    g e r a
    fis d r g
    eis cis fis h
    cis h cis cis,
    fis4 r8 fis
    h h, h h
    a4 h8 fis'
    g e? a a,

    d fis g a
    h a g fis
    g fis e d
    h' a g fis
    g fis e d
    a4 a
    a a
    a a
    a a
    a a
    d r8 d'
    d cis16 h cis8 d~
    d cis16 h cis8 a
    d h g a
    d,4 r
  }
}