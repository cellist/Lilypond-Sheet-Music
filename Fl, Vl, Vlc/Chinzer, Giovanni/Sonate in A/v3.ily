vc = \relative c' {
  \voiceconsts
  \clef "bass"
  
  \introa
  \repeat tremolo 4 a8\mf \repeat tremolo 4 a
  a a gis gis a a, r a16 h
  cis4 d8 dis e e, gis e
  r fis' dis h r e cis a
  h e fis gis a e cis a
  h e h' h, e h gis e
  r8 e' gis h r e, a cis
  r e, gis h r fis dis h
  r e d! cis h gis' fis e

  a a, h cis d a h a
  \repeat tremolo 4 e' e4 r
  a,8 cis16 d e8 e, a4 r
  r8 fis' fis fis e2\fermata \bar "|."

  \introb
  \repeat volta 2 {
    a,8\f h cis a d h e e,
    a a' a gis fis fis16 e dis8 h
    e e16 fis gis8 e a fis h h,
    e e cis a h gis gis e
    a a16 h cis8 a d? h e e,
    a a' a e fis dis dis h

    e e cis a d! e fis gis
    a a, a a h a gis e
    a a cis e a,4 d
    e r r2
    r8 e, e e a2
    h cis
    d8 e fis gis a a, cis a

    d h e e, a a' fis d
    e cis cis a d d16 e fis8 d
    g e a a, d d' cis a
    h gis! gis e a, a' a gis
    fis dis dis h e e, e e
    \repeat tremolo 4 e \repeat tremolo 4 e
    \repeat tremolo 4 e e4 h'\trill

    e,2 r
  }
  \repeat volta 2 {
    e'8 fis gis e a fis h h,
    e, e' e dis cis cis'16 h ais8 fis
    h, h16 cis dis8 h e cis fis fis,
    h h' gis e fis dis dis h
    e e16 fis gis8 e a? fis h h,

    e e cis a d h e e,
    a a cis a h gis gis e
    a a' a gis fis dis dis h
    e e gis e a a, a a
    d! d, d d gis' gis, gis gis

    cis e, e e fis' fis, fis fis
    \repeat tremolo 4 h e gis a cis

    h gis gis e a, a16 h cis8 a
    d h e e, a a' a gis
    fis dis dis h e e16 fis gis8 e
    a fis h h, e e cis a
    h gis gis e a a' fis d?
    g a h cis d d, d d

    e d cis a d d fis a
    d,4 g, \repeat tremolo 4 a8
    \repeat tremolo 4 a \repeat tremolo 4 a
    \repeat tremolo 4 a a4 e'\trill
    a,2 r
  }
  
  \introc
  d,4\mf d' d
  d d d
  d d, d
  a' a a
  a a a
  a a a
  d d d
  g g g
  fis fis fis
  e cis a
  d a fis'
  g g g

  g g g
  a a a
  a a a
  h h h
  h h h
  cis cis cis
  cis cis cis
  d d,8 e fis4
  g a a,
  d2 a4
  h2 h4

  g2 gis4
  a2 d4
  g,? a2
  d,2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    a'8\f e' e,
    a4 r8
    a d a
    h fis a
    d d16 e fis gis
    a8 a, r
    h h16 cis d e
    fis8 fis, r
    d'4 d8
    e e e

    e e e
    e e e
    e e e
    e e e
    e e e
    a, a' a
    gis gis gis
    fis fis fis
    e e e
    d d d
    d4 cis8
    d e e,

    a4 r8
    a4 r8
    a4 r8
    a4 r8
    a d e
    a,4 r8
  }
  \repeat volta 2 {
    a e' e,
    a4 r8
    a cis a
    d d, r
    h' fis' fis,

    h h h
    h dis h
    e e, r
    e'4.~
    e~
    e
    e8 gis h
    e,4.~\p
    e~
    e
    e8 gis\f e

    h h h
    h h h
    h h h
    h h h
    h h h
    h h h
    e e e
    dis dis dis
    cis cis cis
    h h h

    a a a
    gis c cis
    fis gis gis,
    cis4 r8
    fis fis fis
    h,4 r8
    e e e
    a,4 r8
    a4 r8
    a4 r8
    
    a4 r8
    a d e a,4\parenthesize\fermata r8
  }
}