va = \relative c'' {
  \voiceconsts

  \introa
  d8. c16 h8. c16 d8. e16
  d4 h' r
  c,8. h16 a8. h16 c8. d16
  c4 a' r

  d,8. c16 h8. c16 d8. e16
  d4 g fis
  e8 d c4 h
  h a r
  d d d
  \tuplet 3/2 4 { e8( d cis) } \grace cis8 d4 r
  \tuplet 3/2 4 { g8( fis e) } \grace e fis4 r

  \tuplet 3/2 4 { h8( a g) } \grace g a4 r
  a g fis
  \grace fis8 e2 fis4
  g \grace fis8 e2\trill
  d4 r2
  c?8. h16 c8. d16 c8. d16
  h8. a16 h8. c16 a8. h16

  c8. h16 c8. d16 c8. d16
  \grace d8 c2 h4
  c \grace h8 a2\trill
  g4 d' d
  d g g
  fis2.\fermata \bar "|."

  \introb
  \repeat volta 2 {
    \partial 8 d,8
    g16 fis g4 a8
    h16 a h4 c8
    d c16 h a8 g
    \grace g fis4 r8 g
    a h c h16 a
    h8 d r h

    a d r a
    h d r h
    h a r h16 c
    d8 d d d
    d g d e
    c4 h
    a16 g a h a8 d

    fis,16 e fis g a8 h
    a16 g a h a8 d
    fis,16 e fis g a8 h
    cis16 h cis d e8 fis
    e16 d e fis e8 a

    cis,16 h cis d e8 fis
    e16 d e fis e8 fis
    g h16 a g8 fis
    e g16 fis e8 d
    cis e16 d cis8 h
    a16 gis a h cis8 d

    cis16 h cis d e8 fis
    g? fis16 e a8 d,
    fis4 e\trill
    d r8
  }
  \repeat volta 2 {
    a
    d16 cis d4 e8
    fis16 e fis4 g8

    a g16 fis e8 d
    \grace d cis4 r8 d
    e fis g fis16 e
    fis8 a r fis
    e a r e
    fis a r fis
    fis e r4

    g8 h r g
    fis h r fis
    g h r g
    g fis r4
    h,8 d r h
    a d r a
    h d r h

    h a r h16 c?
    d8 d d d
    d e16 fis g8 a16 h
    c4 h
    a16 g a h a8 d
    a16 g a h a8 d
    fis,16 e fis g fis8 g

    d4. e16 fis
    g8 fis16 e d8 c
    h16 a h c d8 g
    h,16 a h c d8 g
    h,4 a\trill
    \partial 4. g r8
  }

  \introc
  h4 h h
  c8 h c4 r
  a' c, c
  h8 a h4 r
  g' h, h
  a8 g a4 r
  fis' a, a

  g g2\trill
  fis4 h a
  gis8 a h c d c16 h
  c2.~
  c4 fis a~
  a g? fis
  e8 fis g a h a16 g

  a2.~
  a4 dis,8 e fis4~
  fis e8 fis g4
  fis e8 dis e fis
  dis4. dis8 e4~
  e8 fis e4 dis
  e c8 d! e h

  a2.~
  a2 g4~
  g fis2\trill
  e2.\fermata \bar "|."

  \introd
  \repeat volta 2 {
    g'8 d c
    \tuplet 3/2 8 { h16( a g) } g4\trill
    \tuplet 3/2 8 { e'16( fis g) } d4\trill
    \tuplet 3/2 8 { e16( fis g) } d4\trill
    \tuplet 3/2 8 { fis16( g a) } c,4\trill
    \tuplet 3/2 8 { h16( a g) } g4\trill
    \tuplet 3/2 8 { h16( c d) } a4\trill
    \tuplet 3/2 8 { h16( c d) } a4\trill

    a'8 d, cis
    d a'16 g fis a
    h d e,4\trill
    d r8
    g d e
    h8. d16 c? e
    d8 g,16 h a c
    h a h d c e

    d8 e16 d c h
    h8 a r
    c16( h c) a' c, a'
    h,( a h) g' h, g'
    c,( h c) a' c, a'
    h,8 d d
    g fis16 e d c

    h c d8 fis
    g fis16 e d c
    h8 e e~
    e a16 cis, d8~
    d g16 h, c!8~
    c fis16 a, h8~
    h e16 g, a8~
    a d16 fis, g8
    c4 h8

    e \grace h a4\trill
    g4.
  }
  \repeat volta 2 {
    g'8 d c
    \tuplet 3/2 8 { h16( a g) } g4\trill
    \tuplet 3/2 8 { d'16( e f) } f4\trill
    \tuplet 3/2 8 { d16( e f) } f4\trill
    \tuplet 3/2 8 { d16( e fis!) } fis8.[\trill e32 d]
    \tuplet 3/2 8 { c16( h a) } a4\trill
    \tuplet 3/2 8 { a'16( fis g) } g4\trill
    
    \tuplet 3/2 8 { e16( fis g) } g4\trill
    \tuplet 3/2 8 { e16( fis g) } g8.[\trill fis32 e]
    \tuplet 3/2 8 { d16( cis h) } h4\trill
    \tuplet 3/2 8 { h16( cis d) } d4\trill
    \tuplet 3/2 8 { h16( cis d) } d4\trill
    \tuplet 3/2 8 { h16( cis d) } d8.[\trill cis32 h]
    \tuplet 3/2 8 { a16( gis fis) } fis4\trill

    \tuplet 3/2 8 { a16( h c?) } c4\trill
    \tuplet 3/2 8 { a16( h c) } c4\trill
    \tuplet 3/2 8 { a16( h c) } c8.[\trill h32 a]
    \tuplet 3/2 8 { g16( fis e) } e4\trill
    \tuplet 3/2 8 { c'16( d e) } c8[ h]
    ais4 h8
    \tuplet 3/2 8 { h16( c d) } h8[ a!]
    gis4 a8

    \tuplet 3/2 8 { a16( h c) } a8[ g!]
    fis4 g8
    e' c h
    a4 r8
    d a h
    fis8. a16 g h
    a8 d,16 fis e g
    fis e fis a g h
    a g a c h d

    c( h c) a' c, a'
    h,8 e e~
    e a16 cis, d8~
    d g16 h, c!8~
    c fis16 a, h8~
    h e16 g, a8~
    a d16 fis, g8
    c4 h8
    e \grace h a4\trill
