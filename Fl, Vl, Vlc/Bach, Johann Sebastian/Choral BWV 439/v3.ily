vc = \relative c {
  \voiceconsts
  \clef "bass"

  e4. fis8 g4 e
  a g fis g\fermata
  dis e a g
  fis e h2\fermata
  e4. fis8 g4 e

  a g fis g\fermata
  dis e a g
  fis e h2\fermata
  h'4 ais h dis,
  e h e e,\fermata
  e' dis e cis

  fis fis, h2\fermata
  dis4 e a, g
  c? a h \breathe h'8( a)
  g( fis) e4 a e
  h' h, e2\fermata
  h'4 ais h dis,

  e h e e,\fermata
  e' dis e cis
  fis fis, h2\fermata
  dis4 e a, g
  c? a h \breathe h'8( a)
  g( fis) e4 a e
  h' h, e2\fermata \bar "|."
}