vb = \relative c'' {
  \voiceconsts

  \repeat volta 2 {
    d16( cis d b a g)
    fis( g a fis d c!)
    b8 r4
    d8 r4
    d'16 cis d b a g
    es' d es c b a

    g es d c b a
    b es d c b a
  }

  \repeat volta 2 {
    R4.
    c'16( a g f e f)
    R4.
    d'16( f es? d c b)

    R4.
    g'16 fis g f es d
    es d es d c b
    a g f8 r
    d4.
    a

    d
    a
    d8 r4
    g'16 fis g es d c
    b g f! es d c
    d( g f es d c)

    d' es f d g f
    f es d c h c
    b! a gis a r8
    R4.*3

    d16 cis d b a g
    fis g a fis d c
    R4.
    es'16 d es c b a
    g es d c b a
    b c b a b8
  }
}