vc = \relative c' {
  \voiceconsts
  \clef "bass"
  
  \repeat volta 2 {
    g8 r4
    <d d'>8 r4
    <g \parenthesize b>8 r4
    <d \parenthesize d'>8 r4
    g8 r4
    c,16 c' r4

    d,16 d' r4
    g,,16 g' r4
  }

  \repeat volta 2 {
    g8 r4
    a8 r4
    a8 r4
    b8 r4

    d,8 r4
    es8 r4
    r8 es es
    f r4
    f4.
    f

    f
    f
    b8 r4
    es,16 es' r4
    f, f,8
    b r4

    h'8 r4
    c8 r4
    cis8 r4
    d8 r4
    g,8 r4
    d8 r4

    g8 r4
    d8 r4
    g8 r4
    c,?16 c' r4
    r8 d, d,
    g8 r b'
  }
}