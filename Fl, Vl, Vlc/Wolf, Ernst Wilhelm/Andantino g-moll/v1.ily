va = \relative c''' {
  \voiceconsts

  \repeat volta 2 {
    R4.*2
    d16( cis d b a g)
    fis( g a fis d c!)
    b8 r4
    g'16 fis g es d c

    b c b a g fis
    g8 r4
  }

  \repeat volta 2 {
    b16( a b d c h)
    R4.
    c16( h c es d cis)
    R4.

    b'?16( a b a g fis)
    b a b a g fis
    g fis g f es d
    c b a g f es
    f'( e f d c b)
    c( h c a f es!)

    f'( e f d c b!)
    c( h c a f es!)
    f'( e f d c b!)
    b' a b g f es!
    d es d c b a
    b8 r4

    R4.*2
    r4 b'16 a
    g fis e d b' a
    d cis d b a g
    fis g a fis d c!
    
    b8 r4
    R4.
    d16 cis d b a g
    g' fis g es d c!
    b c b a g fis
    g es d c g'8
  }
}