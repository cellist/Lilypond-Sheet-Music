vb = \relative c' {
  \voiceconsts

  \repeat volta 2 {
    \partial 4 f4
    g f f g
    a h c\fermata a
    b! b a8 h c4
    c h c\fermata f,

    f e f8 g f4
    \partial 2. f( e) f\fermata
  }
  g( e) f2\fermata
  e4( f8 g) f2\fermata
  f4 f e f

  f8 g f4 e f
  f f f( e)
  f2\fermata a4 c
  b? a f8 g f4
  \partial 2. f( e) f\fermata \bar "|."
}