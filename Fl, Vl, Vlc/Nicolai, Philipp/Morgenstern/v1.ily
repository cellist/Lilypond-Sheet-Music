va = \relative c' {
  \voiceconsts

  \repeat volta 2 {
    \partial 4 f4
    c' a f c'
    d d c\fermata c
    d e f e
    d d c\fermata a

    d c b a
    \partial 2. g2 f4\fermata
  }
  c'2 a\fermata
  c a\fermata
  b4 a g a

  b a g a
  b a g2
  f\fermata f'4 e
  d c b a
  \partial 2. g2 f4\fermata \bar "|."
}