vb = \relative c' {
  \voiceconsts

  \introa
  \repeat volta 2 {
    h8 c d4 e
    h'2 c4
    g a2
    h4 g8( a h g)
    h, c d4 e

    h'2 h4
    g a2
    h2.
  }

  \repeat volta 2 {
    fis2 g4
    a e fis
    g2.

    fis4 d8( e fis d)
    fis2 g4
    a e8( fis) g4~
    g2 fis4 h,2.
  }

  \introb
  \repeat volta 2 {
    c
    h
    r4 a' gis
    a8( gis) a h a4
    c,2.

    h
    r4 a' gis
    a2.
  }

  \repeat volta 2 {
    c2 c4
    c2 h4
    c2.

    h2 c4
    c8 h a gis fis gis
    e4 h'2
    a4 gis2
    a2.
  }
}