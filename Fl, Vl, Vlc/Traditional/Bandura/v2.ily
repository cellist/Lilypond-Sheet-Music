vb = \relative c'' {
  \voiceconsts

  a2.
  d
  c
  a2 e4
  gis2 f4
  e2 d4
  c2 e4
  a r2
  \repeat volta 2 {
    e4 d2
    e gis4
    e c2
    e dis4
    d! f2
    e d4
    c2.~

    c4 d e
    a g?2
    f d4
    c d e
    c f e
    d2 f4
    e2 d4
    c d e
    c2.
    f4 g a
    f e4. d8
    c4 d e
    c f e
    d2 f4

    e2 d4
  }
  \alternative {
    { c2.~ | c4 r2 }
    { c2.~ | \fine c }
  }
  \repeat volta 2 {
    e4 d2
    e4 e gis
    e c2
    e4 e dis
    d! f2
    e d4

    c2.~
    c4 d e
    a g2
    f d4
    c d e
    c f e
    d2 f4
    e2 d4
    c d e
    c2.

    f4 g a
    f e4. d8
    c4 d e
    c f e
    d2 f4
    e2 d4
    c2.~
    c4 r2\parenthesize\segno
  }
}