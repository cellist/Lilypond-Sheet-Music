va = \relative c'' {
  \voiceconsts

  fis4\f a h g
  a( g) fis r
  d fis a d,
  g h h a
  fis8( g) a d, g4 fis8( g)

  fis4( e) d r
  g( a) h( a)
  g( fis) fis e
  fis8( g) a( d,) g4 fis8( g)
  fis4( e) d r \boxa

  a'2\mf cis4 h
  a( g) a2
  a8( gis) a( e) fis( gis) a( h)
  a4( gis) a r \boxb

  cis( h) a a
  g?( e) cis( d)
  d'8(\f cis) d( a) h( cis) d( e)
  d4( cis) d r \boxc

  d e8( d) cis4 d8( a)
  a4( g) g( fis)
  d'(\mf cis) h( e)
  d( cis) d r
  g,2 h4( a)
  g fis a g

  a2 a4( g)
  a( g) fis r \boxd
  a2 cis4( h)
  a( g) a2
  a4( gis) fis( h)
  a( gis) a r \boxe

  a8(\f h) cis a d4( fis,)
  g( h) h( a) \rall
  d8(\< cis) d( a) h( cis) d(\! e)
  d4\ff cis d2 \bar "|."
}