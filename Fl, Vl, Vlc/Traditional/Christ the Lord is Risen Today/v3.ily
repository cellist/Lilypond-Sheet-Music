vc = \relative c {
  \voiceconsts
  \clef "bass"

  d8(\f e) fis( d) g4 e
  a( a,) d r
  d\mf d cis d
  h g d'2
  d8( e) fis d e4 fis8( g)

  a4 a d, r
  h( d) g( fis)
  e g, a a
  d8( e) fis( d) e4 fis8( g)
  a4 a d, r \boxa

  a'2 a4( g)
  fis( a) d( d,)
  a'8( h) cis( a) h4 cis8( d)
  e4 e, a, a' \boxb

  a( g) fis( d)
  h( g') g( fis)
  fis( d) g( e)
  a( a,) d r \boxc

  d(\f fis) a( d,)
  g( h) h( a)
  fis8( g) a( d,) g4 fis8( g)
  fis4( e) d r

  g( a) h( a)
  g fis8( g) fis4 e
  fis8( g) a( d,) g4 fis8( g)
  fis4( e) d r \boxd

  a'2\mf a4( g)
  fis( a) d( d,)
  a'8( h) cis( a) h4 cis8( d)
  e4 e, a, a' \boxe

  a( g) fis( d)
  h( g') cis,( d) \rall
  fis(\< d) g( e)\!
  a\f a, d,2 \bar "|."
}