vb = \relative c'' {
  \voiceconsts

  d8(\ff cis) d( a) h( cis) d( e)
  d4( cis) d r
  d\mf d e d
  h g g fis
  d' cis h e

  d( cis) d r
  h( d) g( fis)
  e( d) d( cis)
  d( cis) h( e)
  d( cis) d r \boxa

  cis(\f d) e( a,)
  d( e) fis2
  cis8( d) e( a,) d4 cis8( d)
  cis4( h) a r \boxb

  a8( h) cis( a) d4 fis,
  g( h) h( a)
  d(\mf cis) h( e)
  d( cis) d r \boxc

  d( e) cis( d)
  h( g) g( fis)
  d8( e) fis( d) e4 d8( e)
  d4( cis) d r
  h'2 d4( g)
  e d8( e) d4 cis

  d( cis) h e
  d( cis) d r \boxd
  cis(\f d) e( a,)
  d( e) fis2
  cis8( d) e a, d4 cis8( d)
  cis4( h) a r \boxe

  cis(\mf h) a( fis)
  g( e) g( fis) \rall
  d'(\mf\< cis) h( e)\!
  d\f cis d2 \bar "|."
}