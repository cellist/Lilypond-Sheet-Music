va = \relative c'' {
  \voiceconsts

  h8.\mf c16(^\soav d e) d8[ d] d16.( h32)
  g'8( fis e) d r4
  h8. c16( d e) d8[ d] d16.( h32)
  c8 c16.( d32) h16.([ c32) a8] r4

  g8( h d) a( c d)
  h16( h' a g fis g) e4 fis8
  g16( fis e d c h) \grace h a8 g fis
  d'4.(\< dis)
  e16(\! g h g e c) h( a c a g fis)
  g8 r4 \grace { h16[ c] } d?4 h8

  \grace { c16[ d] } e4 c8 a'16( c h a g fis)
  g8.\trill h16 d8 \grace { g,16[ a] } h4 g8
  fis16( e dis e g e) d( e fis g a h)
  g8 r g32( a h g) c8 r fis,32( g a fis)

  g8 r d32( e d c) h8 r h32( c h a)
  g8 g g g4 r8
  r g g d4.
  r8 g g e4.
  r16 d( fis a c a) h8.\trill d16 g8
  g( fis) fis fis4 \tuplet 3/2 8 { a16( h a) }

  d8\fp d d d16( cis h a g fis)
  e8 e16.( h32 g'16. e32) h'4 a32( g fis e)
  \grace e16 dis8 dis dis dis16( e fis dis h dis)
  e( dis e fis g fis) e( dis e fis e d)

  c( a') e([ g]) fis( d) cis([\< a']) e( g)\! fis32([ e fis d])
  cis8-.\f e-. a-. a,4 r8
  fis4\pp fis8 \grace { e16[ fis] } g8. fis16 e8
  d4 \grace fis16 e( d32 e) fis8-. fis( g)
  a4 a8 \grace { g16[ a] } h8. a16 g8
  fis4 \grace a16 g( fis32 g) a8-. a( h)

  c fis([ a]) d,, a''([ c])
  h16. g32 g16[\trill fis32 g] h16. d32 cis16.[\< a32] a16\trill gis32 a\! cis16.[ e32]
  d16( cis d) a-. h-. cis-. d( cis d) e-. fis-. g-.
  a4 r8 \afterGrace c,,!4.\trill { h16[ c] }

  h8. cis16( d dis) e( fis g a h g)
  fis4 a8 \grace a16 g8 fis e
  d? r \tuplet 3/2 8 { a'16( fis d) } cis8 r \tuplet 3/2 8 { g'16( e cis) }
  d8 r \tuplet 3/2 8 { a'16( fis d) } cis8 r \tuplet 3/2 8 { g'16( e cis) }
  d4( fis8 d4 fis8)

  d4.\fermata cis4( c8)
  h8. c16( d e) d8[ d] d16.( h32)
  g'8( fis e) d r4
  h8. c16( d e) d8[ d] d16.( h32)
  c8 c16.( d32) h16.([ c32) a8] r4

  g32( d g h) \repeat tremolo 4 d16 a32( d, fis a) \repeat tremolo 4 d16
  d( h' a g fis g) e8~ e32[ g( fis e] fis a g fis)
  g16( fis e d c h) \grace h a8 g fis
  d'4.(\< dis)

  e16(\! g h g e c) h( a c a g fis)
  g8 r4 \grace { h16[ c] } d4 h8
  \grace { c16[ d] } e4 c8 a'16( c h a g fis)
  g8.\trill h16 d8 \grace { g,16[ a] } h4 g8

  fis16( e dis e g e) d( e fis g a h)
  g8 r g32( a h g) c8 r fis,32( g a fis)
  g8 r d32(\pp e d c) h8 r h32( c h a)
  g8 g g g4 r8 \bar "|."
}