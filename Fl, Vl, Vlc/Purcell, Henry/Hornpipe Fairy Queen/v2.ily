vb = \relative c' {
  \voiceconsts

  \repeat volta 2 {
    b4\f es d b8 c d4 c'8 b
    a4 b8 c d4 fis,8 g a4 fis
    d8 c b c d b a b c a g a

    g4 g' fis c b es
    d g8 a b4 c8 b a4 a8 b
    c4 b8 a g4 g8 a b2

    b4 a b f? g as8 g
    d2 es d
  }

  \repeat volta 2 {
    f8\mf es d4 f8 es d4 g8 f es d

    c b a?4 c8 b a4 f' d
    es8 f g4 es8 f g4 es8 d c b
    a2. b8 c a4 d\f

    d8 b e fis g d g4 a8 f a4
    b8 f b4 d8 b d4 b4. a8

    fis d fis4 d'8 c b a g f es fis
    g2 fis g
  }
}
