va = \relative c'' {
  \voiceconsts

  \repeat volta 2 {
    g4\f b8 c d4 e8 fis g4 a8 g
    fis2. e4 d d8 c

    b es! d4 a8 d c4 g8 c b4
    b2. a4 g2
    b4 b8 c d4 d8 es f?4 es8 d

    g4 g8 a b4 a8 g f g f4
    es8 f es4 d8 es d4 c8 d b4
    b2. a4 b2
  }

  \repeat volta 2 {
    d8\mf es f4 d8 es f4 es8 d c b
    a b c4 a8 b c4 d8 c b a

    g a b4 g8 a b4 c8 b a g
    fis2. g8 a d,4 e8\f fis
    g d g4 b8 g b4 c8 a c4

    d8 b d4 f?8 d f4 g8 e g4
    a8 fis a4 b8 fis g d es! c d a
    a2. g4 g2
  }
}
