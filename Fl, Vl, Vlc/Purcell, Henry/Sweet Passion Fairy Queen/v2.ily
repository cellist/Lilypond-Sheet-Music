vb = \relative c'' {
  \voiceconsts

  \repeat volta 2 {
    \partial 4 b4\mp
    a d, g
    a fis g
    g4.( es8) fis4
    d2 b4
    g' f?8( g) a4
    b g b8( a)

    g( b) c( b) a4
    fis2 \boxa fis!4\mf
    g a b
    g8( b) a( g) f?4
    f es d
    c2 a'4
    b8( c) a( b) c4

    a b g
    b es,4.( d8)
    d2 f4\f
    f2 f4
    c' f, b

    g a8( b) c4
    a2 a4
    b2\mf c4
    a( g) g
    g( fis) d
    \partial 2 d2
  }
}
