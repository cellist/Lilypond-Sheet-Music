vc = \relative c' {
  \voiceconsts
  \clef "bass"
  
  \repeat volta 2 {
    \partial 4 g4\mp
    g fis g
    c, d b
    es4.( c8) d4
    g,2 g'4
    a2 f?4
    b8( c) d( a) g( f)
    es2.

    d2 \boxa d4\mf
    g8( f) es4 d
    c f d
    es8( d) c4 b
    f2 f'4
    g f es
    d b es

    c f f,
    b2 b'4\f
    b2 a4
    b2 g4
    c2 a4

    d4.( c8) b( a)
    g4\mf g, a
    b2 c4
    d2 d,4
    \partial 2 g2
  }
}
