va = \relative c'' {
  \voiceconsts

  \repeat volta 2 {
    \partial 4 d4\mp
    c4.( d8) b4
    c a d
    b4.( a8) b( g)
    g2 es'8( d)
    c4 c d16( es f8)
    d4 b d

    d es8.( d16) c4
    d2 \boxa d8(\mf c)
    h4 c d
    es c f
    g, a b?
    a2 d4
    es d g

    g8( f) g( f) es( d)
    es( d) c( d) c( b)
    b2 d8.(\f es16)
    c4 c c16( d es8)
    es4\(( d) d16( e f8)\)

    f4( e) e16( fis g8)
    fis4.( e8) d4
    g\mf d8( es!) f!4
    d b8( c) d4
    b4.( a8) g4
    \partial 2 g2
  }
}
