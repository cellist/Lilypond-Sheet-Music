vb = \relative c' {
  \voiceconsts

  \repeat volta 2 {
    e4\f g8( e) c4-. c-.
    e g8( e) c4-. e-.
    a8( g f e) g( a g a)
    h( a g f g4) r
    e(\p g8 e c4)-. c-.

    g'( c8 g e4)-. a8( fis)
    h( g a fis) g( e fis d)
    h4\f r h'8( c d e)
    fis,4( fis')-. fis-. fis-.
    g,8( a h c) d( e fis g)

    a,4( a')-. a-. a-.
    g,8( h d g a g fis e)
    d( c) e( d) fis( e d c)
    c( h a  g) h( a g fis)
    g4 r r2
  }

  \repeat volta 2 {
    h4(\p d8 h g4)-. g-.
    c( es8 c g4)-. g'(
    f? d) es( c)
    h8( c d h g4)-. g-.
    g'8(\f g,) g'( g,) g'( g,) g'( g,)

    g'( g,) g'( g,) g'( g,) g'( g,)
    d'( es f d) f( es d c)
    g'4 r r2
    c,,4(\p e?8 c g4)-. g-.
    c( e8 c g4)-. g'-.

    f8( e d c) h( c) h( c)
    d( c h a g4) r
    c( g8 c e4)-. e-.
    e(\cresc c8 e g4)-. c-.
    g f e d

    c8(\f d e f g a h c)
    d,4( d')-. d-. d-.
    e,8( f g a h c d e)
    f,4( f')-. f-. f-.

    g,8( c e g) f( e d c)
    a'( g f e) d( c h a)
    g( a) f( g) e( f) d( e)
    c4 r r2
  }
}