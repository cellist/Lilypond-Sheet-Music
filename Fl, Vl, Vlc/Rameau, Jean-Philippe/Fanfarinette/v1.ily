va = \relative c'' {
  \voiceconsts

  \repeat volta 2 {
    \partial 8 e8
    e4(\prall d8) d4 g8
    c,4.~ c8 d f
    h,4\prall c8 g16 a h c d e

    e8.\prall d16 e8 d4 g8
    g4(\prall fis8) c'( h) a
    \appoggiatura a g4.(~\prall g8 fis) e
    d( c) h \appoggiatura h a4\trill g8
    g'4.(~ g8 fis) e

    d( c) h \appoggiatura h a4\trill g8
    g'4.(~ g8 fis) e
    d( c) h \appoggiatura h a4\trill g8
    g4.~ g4
  }

  \repeat volta 2 {
    h8
    h4(\prall a8) a4 cis8
    d4.~ d8 cis d
    e a, g' g( f) e
    f4. e8( d) a'
    a4\prall gis8 d'( c?) h

    \appoggiatura h16 a8.([\trill gis16 a]) r a8( g) f
    e( d) c \appoggiatura c h4\trill a8
    a'4.(~ a8 g) f
    e( d) c \appoggiatura c h4\trill a8
    a4.~ a4 \breathe a8

    a4\prall g8 g4 c8
    a4.\prall g4 c8
    a4 a8 g4 c8
    a4.\prall g4 \breathe a8
    a4\prall g8 a4 h8
    c4.~ c8 h c

    d g f e( d)\prall c
    d4 g,8 g4 \breathe g'8
    g e f d' d, f~
    f e g~ g c, e~
    e d f~ f h, d~

    d c e~ e g, c
    a( h) c g c h
    c4.~ c4 \breathe e8
    e4\prall a8-! a4\prall d8-!
    d4. g,8[ \breathe c g]
    a( h) c g c h

    c4.(~ c8 h) a
    g( f) e \appoggiatura e d4\trill c8
    c'4.(~ c8 h) a
    g( f) e \appoggiatura e d4\trill c8
    c4.~ c4
  }
}