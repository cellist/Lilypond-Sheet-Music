va = \relative c'' {
  \voiceconsts

  c4.\mf c8 f4. f8
  e4.( d8) e2
  e8( g e d) e4( c)
  d4.( e8) f2

  e8( g e d) e4( c)
  c4.( h8) c4 r \boxa
  g2.(\mp a4)
  g4.( f8) e4 f
  e2. r4 \boxb

  c'2\pp d4( e)
  d( h) cis cis
  d( c!) c( fis,)
  g g'2( fis4)
  e( g) fis( e)
  c( a) h r \boxc

  d2.(\p e4)
  d4.( c8) h4 c
  g2. r4 \boxd
  d'(\mp f?) e( g)
  e4.( d8) e2
  d4( f) e( g)

  e4.( d8) e2
  e4( g) fis( h,)
  d4.( cis8) h2
  h4.( a8) h4 h
  h4.( a8) h2
  h4.( a8) h4.( a8)

  h4.( a8) h(\< a' g f)\!\f \boxe
  c,2\p a'4( h)
  g'( fis) gis2
  e8(\mf g! e d) e4( c)
  d4.( e8) f?2

  e8( f e d) e4( c)
  c8( e c h) c4( a)
  g'4.(\p f8) g4.( f8)

  g4.\pp g8-- g4 r \rall
  g(\mp a) g( a)
  g4.( a8) c2\fermata \bar "|."
}