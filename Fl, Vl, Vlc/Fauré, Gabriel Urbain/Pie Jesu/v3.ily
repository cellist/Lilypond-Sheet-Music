vc = \relative c {
  \voiceconsts
  \clef "bass"

  c2\p a'4( h)
  c( a) e2
  c4( g') e( a)
  h( c) a( h)
  c( a) h( a)
  a( g) c, e8( d) \boxa

  e( g e d) e( g e d)
  e( g e d) e( g e d)
  c2. r4 \boxb

  c'2\pp h4( cis)
  a( gis) b2
  h!4( c?) a2
  e d
  g4( e) h( c)
  e( d) g, h8(\mp a) \boxc

  h( d h a) h( d h a) 
  h( d h a) h( d h a)
  g2. r4 \boxd

  f'8(\p g h f) e( g h g)
  f( g h f) e( g h g)
  f( g h f) e( g c g)
  f( g h f) e( g c g)

  cis,2-> d8 d d d
  e2( fis4) e8( fis)
  cis4( c) fis8( h, fis' fis,)
  cis'4( c) fis8( h, fis' fis,)
  f'!( g h g e g h g)

  f( g h g) f(\< f' e d)\!\mf \boxe
  c4. c8 f4. f8
  e4.( d8) e2
  c,4(\mp g') e( a)
  h( c) a( h)
  c( d) e( a,)

  a( e) d2
  e'8(\p g e d) e( g e d)
  e(\pp g e d) e( g e d) \rall
  e,(\p g e d) e( g e d)
  e( g e d) c2\fermata \bar "|."
}