vb = \relative c'' {
  \voiceconsts

  e2\p a4( g)
  g( fis) gis2
  e4 g!2 e4
  g2( a4 g)
  g( f?) gis( a)
  f( d) e r \boxa

  c2.(\mp c4)
  c4.( a8) g4 e8( d)
  c2. r4 \boxb
  c'4. c8 g'4. g8
  g( fis) e4 fis2

  fis8( g e d) e4( c)
  h4.( c8) d2
  h8( d h a) h4( g)
  g4.( fis8) g4 r \boxc

  h2.(\p c4)
  h4.( a8) g4 h8( a)
  h2. r4 \boxd
  h( d) h( e)
  h d2( h4)
  h( d) h( c)

  h( d2) c4
  h'2-> h,
  g8 g cis cis dis2
  g,4 e'2( dis4)
  g, g'2( fis4)
  f! g2( e4)

  f2 d?4(\f h) \boxe
  c(\mp h) a( h)
  e( d) e2
  e4( g2) e4
  g2( a4 g)
  g( f) gis( a)

  a( g!) f2
  e4.(\p d8) e4.( d8)
  e4.\pp d8-- e4 r \rall
  e(\p f) e( f)
  g( f) e2\fermata \bar "|."
}