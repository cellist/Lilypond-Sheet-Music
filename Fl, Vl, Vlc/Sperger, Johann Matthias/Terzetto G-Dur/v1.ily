va = \relative c'' {
  \voiceconsts

  \introa
  \repeat volta 2 {
    \partial 4 d4\f
    g-! g4.-! h8( a fis)
    g4-! g4.-! h8( a fis)
    g4-! \tuplet 3/2 4 {
      d8( d') d-! d[( c) a]-! c( h) g-!
      a h a g[ fis e] d e d c[ h a]
    }
    g( g') g4.-! h8( a g)
    g4-! g4.-! h8( a fis)
    g4-! \tuplet 3/2 4 {
      d8( d') d-! d[( c) a]-! c( h) g-!
      a-! a-! a-! a([ c a]) \repeat tremolo 3 fis fis( a fis)
    }

    g4-! r r e8(\p d)
    d4-! r r c8( h)
    h4-! r r g-!
    \tuplet 3/2 4 { a8-! a-! a-! a([ c a]) fis-! fis-! fis-! fis([ a fis]) }
    g4 g'-! g-! r
    r fis,\f r fis
    e h'2 h4~
    h h2 h4~

    h h2 r4
    r cis r e
    d a2 a4~
    a a2 g4
    fis r a2
    r8 \repeat tremolo 3 h r \repeat tremolo 3 c?
    r \repeat tremolo 3 d r \repeat tremolo 3 d
    d d4 d8 d d h h

    a a'-! a-! a-! a-!\fp g4( fis8)
    e-! a-! a-! a-! a-!\fp g4( fis8)
    e4-! r r8 e4(\fp d8)
    cis4-! r r8 e4(\fp d8)
    cis-! a-! a-! a-! a4-! r8 a\f
    g'16( a) g-! fis-! e[( fis) e-! d]-! cis4-! r8 a

    g'16 e fis g a[ h cis d] e!8 cis-! a-! g!
    fis16 g a h a[ g fis e] d4 r8 a
    d e16 fis g[ a h cis] d8 a fis d
    g16( fis) e d cis[ d e fis] g fis e d cis[ h a g]
    fis4 d'8\p d dis( e) fis-! fis-!
    fis(\f g) h-! h-! \acciaccatura h a[ g16 fis] \acciaccatura fis8 e d!16 cis
    d4 d8-!\p d dis( e) fis-! fis-!
    fis( g) h-!\f h-! gis( a) h-! h-!

    g( a) a-! a-! a-! a-! a8.(\trill\p gis32 a)
    gis1(
    g!8) g-! g-! g-! g-! g-! g8.(\trill fis32 g)
    fis16(\f g) a-! h-! a[( g) fis-! e]-! fis( g) a-! h-! a[( g) fis-! e]-!

    fis( d) e-! fis-! g[( a) h-! c?]-! d8 a d ais
    h16( a! h) a h[( d h) g] \afterGrace fis4( { d16[ e]) } e4\trill
    d r r2
    e8-! e-! e16[( fis) g-! e]-! cis8-! cis-! cis16[( d) e-! cis]-!

    d4-! r r2
    e8-! e-! e16[( fis) g-! e]-! cis8-! cis-! cis16[( d) e-! cis]-!
    d4-!\f a'16( h) cis-! a-! d4 a16( h) cis-! a-!
    d4-! d-! d-!
  }
  \repeat volta 2 {
    r
    fis,,8(\f a fis a) fis( a g a)
    fis( a fis a) fis( a g a)
    fis4 a2 a4
    cis r r2
    fis,8( a fis a) fis( a g a)
    fis( a fis a) fis( a g a)
    fis4 a2 a4

    h r g r
    fis\f d'( d d)
    d16( e) fis-! g-! a[( h) cis-! d]-! d,4 r
    d16( e) fis-! g-! a[( h) cis-! d]-! d,4 r
    c'16( d) c-! h-! a[( h) a-! g]-! fis( g) fis-! e-! d[( e) d-! c]-!

    c8( h) h4-! r8 h' h h
    fis-! h-! dis,, h''-! h, h'-! fis, h'-!
    \tuplet 3/2 4 { g,( h') a-! g[-! fis-! e]-! g,( h') a-! g[-! fis-! e]-! }
    fis-! h-! dis,, h''-! h, h'-! fis, h'-!
    \tuplet 3/2 4 { g,( h') a-! g[-! fis-! e]-! g,( h') a-! g[-! fis-! e]-! }

    c'2 dis,(
    e fis)
    \tuplet 3/2 4 { g8( e) e-! e[( g) g]-! g( h) h-! } h[-! e]-!
    h,2 \appoggiatura { e16[ fis] } fis2
    e4 r r2
    g,1~
    g4-! r g( d?)
    g1~
    g4-! r e'2~
    e4-! r d2
    d4-! r g,2(
    fis4)-! r g2(

    fis4)-! r g2(\f
    fis4)-! r r d'
    g-! g4.-! h8( a fis)
    g4-! g4.-! h8( a fis)
    g4-! \tuplet 3/2 4 { d8( d') d-! d[( c) a]-! c( h) g-! }
    \tuplet 3/2 4 { a h a g[ fis e] d e d c[ h a] }

    g( g') g4.-! b8( a fis)
    g4-! g4.-! b8( a fis)
    g4-! \tuplet 3/2 4 { d8( d') d-! d[( c) a]-! c( b) g-! }
    \tuplet 3/2 4 { \repeat tremolo 3 a a( c a) \repeat tremolo 3 fis fis( a fis) }
    g4-!  r r es8(\p d)
    d4-! r r c8( b)

    b4 r r g
    \tuplet 3/2 4 { \repeat tremolo 3 a8 a( c a) \repeat tremolo 3 h! h( d h) }
    c4-! r r es8( d)
    d4-! fis8( g) g4-! es8( d)
    d4-! fis8( g) g4-! g16(\< a g a)
    b2-! cis,-!\!
    e?( d4) r
    r c?\f r c
    h?2 r

    r4 c r c
    h2 r8 h-! d-! c-!
    h( d h d) h( d c d)
    h( d h d) h( d c d)
    h4-! r d2(
    e?4)-! r e, r
    g8 g4 g8 g g fis fis
    g4 r r2
    r r4. d'8

    c'16( h) a-! g-! fis[ g a h] c h a g fis[ e d c]
    h g a h c[ d e fis] g a h c d8 r16 d,
    c' h a g fis[ g a h] c h a g fis[ e d c]

    h g a h c[ d e fis] g a h c d8 r16 d,
    c' h a g fis[ g a h] c h a g fis[ e d c]
    h4 g8-!\p g-! gis( a) h-! h-!

    h( c) e[-!\f e]-! \acciaccatura e d( c16 h) \acciaccatura h8 a[( g16 fis)]
    g4-! g'8-!\p g-! gis( a) h-! h-!
    c( d) e-! e-! cis( d) e-! e-!
    cis( d) d-! d-! d[-! d]-! d8.\trill cis32( d)

    cis1(\p
    \repeat tremolo 4 c!8) c-! c-! c8.\trill h32 c
    h16(\f c) d-! e-! d[( c) h-! a]-! h c d e d[ c h a]
    h8 g,?-! h-! d-! g-! h-! d-! g-!

    d,,8( d'') \acciaccatura c h[( a16 g)] \grace { g[ a] } a2\trill
    g4 r r2
    a,8-! a-! a16[( h) c-! a]-! fis8-! fis-! fis16[( g) a-! fis]-!
    g4-! r r2
    a'8-! a-! a16[( h) c-! a]-! fis8-! fis-! fis16[( g) a-! fis]-!

    g4-! d16(\f e) fis-! d-! g4-! d16( e) fis-! d-!
    \partial 2. g4-! g-! g-!
  }

  \introb
  \repeat volta 2 {
    \partial 8 d8-!\mf
    d(^\dolc b') g-! g( fis) g-!
    a-! c,( b) b( a) d-!
    d( b') g-! g( fis) g-!
    a-! c,( b) r16 a( c a es' c)
    a-! fis'( a fis c' a) fis( a d, fis) g8-!

    g,4( a16 fis g4) r8
    b-!\f b-! b-! a16( b c a) f?8-!
    d'-! d-! d-! c16( d es c) a8-!
    \repeat tremolo 6 f'
    f16( g f g f g) f( g f c' a f)
    b8-! f16( g f g) f( g f c' a f)
    
    b8-!\p b16( a b g) f8-! b16( a b g)
    f4-! r8 f(^\dolc f b)
    fis[ \acciaccatura a g es16( c)] b8. d16 c a
    b8-!\p b'16( a b g) f!8-! b16( a b g)
    f4-! r8 f-!^\dolc f( b)

    fis[ \acciaccatura a g es16 c] b8.( d16 c a)
    b8 r \tuplet 3/2 8 { f'!16( g f) } b8[ f] \tuplet 3/2 8 { c'16( a f) }
    b8 r \tuplet 3/2 8 { f16( g f) } b8[ f] \tuplet 3/2 8 { c'16( a f) }
    b8 r b,-! b4-!
  }
  d8\f
  \repeat tremolo 3 d,-! d fis a
  c( a fis) es4( d8)

  R2.
  c''8(\f a fis) es4.(-!
  d8) r d,[-! d]-! r4 \boxa
  h'4^\dolc\mf c16( a) \repeat tremolo 3 g8
  c4( h8) h16( a fis d) g8-!
  e'4( d8) fis16( g a fis g h)
  a8-! c,( h) h4( a8)
  h'4-! c16( a) \repeat tremolo 3 g8

  c4-! h8-! h16( a fis d) g8-!
  e4( d8) fis16( g a fis g h)
  a8 c, h16( g') fis( c' a fis g h)
  a8 c, h16 g' fis( c' a fis g h)
  d( h g h a fis)  g8 r \boxb d\p

  d( c b) a r es'
  es( d c) b r cis(\pp
  d)-! r cis([ d])-! r4
  \repeat tremolo 3 g,8-!\f fis16( g a fis) d8-!
  \repeat tremolo 3 b'-! a16( b c a) fis8-!

  \repeat tremolo 3 d'-! \repeat tremolo 3 d-!
  d16( es d es d es) d( es d a' fis d)
  g8-! d16( es d es) d( es d a' fis d)
  g8-! g16( fis g d) es8-! a16( g a g)

  fis d, fis a c es fis( a c fis,) g8-!
  g,4-! a16( fis) g8-! r d'-!^\dolc
  d( b') g-! g( fis) g-!
  a-! c,( b) b( a) d-!
  d( b') g-! g( fis) g-!
  \partial 8*5 a r fis-!\f g4-! \bar "|."
}