vc = \relative c {
  \voiceconsts
  \clef "bass"

  \introa
  \repeat volta 2 {
    \partial 4 r4
    g\f g' d d,
    g g' d d,
    g-! h'-! fis-! g-!
    d r r2
    g,4 g' d d,
    g g' d d,
    g-! h'-! fis-! g-!

    c, r d r

    \tuplet 6/4 2 { g,8 g' fis g d h } g4 r
    \tuplet 6/4 2 { g8\p g' fis g d h } g4 r
    \tuplet 6/4 2 { g8 g' fis g d h } g4 h
    c r d r
    g, g'-! g,-! r
    r h\f r a'
    g dis e fis

    g dis e fis
    g dis e r
    r a, r g'
    fis cis d? g
    fis cis d a
    d r fis2
    r8 g-! g-! g-! r a a a
    r h h h r g g g

    \repeat tremolo 4 fis g g gis gis
    a4 r r8 a-! cis(\fp d)
    a4 r r8 a-! cis(\fp d)
    a4 r r8 a,\fp cis d
    a4 r r8 a\fp cis d
    a-! a'-! e-! cis-! a cis e cis
    a4\f a a a

    cis cis cis cis
    d d d d
    d d d d
    a' r cis, r
    d fis8-!\p fis-! g4-! a8-! a-!
    h4-!\f g8 g fis g a a,
    d4-! fis8-!\p fis-! g4-! a8-! a-!
    h4-!\f g8-! g-! fis4-! g8-! g-!

    fis2(^\dolc\p f
    e1)
    a2(-! cis
    d4)\f r8 cis d4 r8 cis
    d4 r \repeat tremolo 4 fis,?8
    \repeat tremolo 4 g a a a, a
    d e16 fis g[ a h cis] d8-! cis-! h-! a-!
    g2 a
    d,8 e16 fis g[ a h cis] d8-! cis-! h-! a-!
    
    g2 a
    d,4\f a8-! a-! d4 a8-! a-!
    d4-! d-! d-!
  }
  \repeat volta 2 {
    r
    d-!\p d-! a'\f a,
    d-! d-! a' a,
    d fis cis d
    a r r2
    d4 d8( fis) a4 a,
    d d8( fis) a4 a,

    d fis cis d
    g r a r
    d, r r2
    d4 r r8 fis'4( d8)
    d4-! r r8 fis4( e8)
    d2. fis,4
    g8 g d h g4 r
    h2 dis4 h
    e r e, r

    h'2 dis4 h
    e r e, r
    r8 \repeat tremolo 3 a'-! r \repeat tremolo 3 a-!
    r \repeat tremolo 3 g-! r \repeat tremolo 3 dis-!
    e4-! r r2
    \repeat tremolo 4 h'8 \repeat tremolo 4 h,
    e4 r r2
    <h d?>1(
    c4)-! r e'( c)

    <h, d>1(
    c4)-! r gis'2(
    a4)-! r fis2(
    g?4)-! r <a, e'>2(
    d4)-! r <a e'>2(
    d4)-! r <a e'>2(
    d4)-! d, d r
    g\f g' d d,
    g g' d d,
    g h' fis g
    d r r2

    g,4\p g' d d,
    g g' d d,
    g b' fis g
    c, r d r
    \tuplet 3/2 4 { g,8 g' fis g[ d b] } g4 r
    \tuplet 3/2 4 { g8 g' fis g[ d b] } g4 r
    \tuplet 3/2 4 { g8 g' fis g[ d b] } g4 b

    c r d r
    es-! r r2
    r4 a8( g) g4-! r
    r a8( g) g4-! r
    r2 g'(
    fis2.) r4
    r <d, a'>\f r <d a'>
    g2 r

    r4 <d a'> r <d a'>
    g2 r8 g-! h?-! a-!
    g4 g, d' d,
    g g' d d,
    g r <h g'>2(
    <c g'>4) r <c g'> r
    \repeat tremolo 4 d8 \repeat tremolo 4 d,
    g( d'') d-! d-! c( h a g)

    d d' d, d d d' a fis
    d2(\f fis)
    g4-! r r h8( g)
    fis1(
    g4)-! r r h8( g)
    fis1(
    g4) h8-!\p h-! c4-! d8-! d-!
    e4-! c8-!\f c-! h( c) d-! d,-!

    g4-! h8-!\p h-! c4-! d8-! d-!
    e4-! c8-!\f c-! h4-! c8-! c-!
    h2(\decr b
    a1)
    d,2\p fis(
    g4) r8 fis\f g4 r8 fis
    g4 r r2
    \repeat tremolo 4 d'8 \repeat tremolo 4 d,

    g,\f a16 h c[ d e fis] g8 fis e d
    c2 d
    g,8 a16 h c[ d e fis] g8 fis e d
    c2 d
    g,4-! d'8\f d g4-! d8 d
    \partial 2. g4-! <g, g'>-! <g g'>-!
  }

  \introb
  \repeat volta 2 {
    \partial 8 r8
    g'4.-!\p a4( g8)
    fis4 g8 d'( d,) r
    g4.-! a4( g8)
    fis4( g8) c4.~\fp
    c a4 g8
    r d d g g, r
    R2.*2

    b'8-!\f b-! b-! a16( b c a) f8-!
    b4.( f
    b f)
    b,8 r4 b8\p r4
    b r8 d'4.(\f
    es4)-! r8 f,4 f,8
    b r4 b8\p r4
    b r8 d'4.(\f
    es4)-! r8 f,4 f,8

    b\f b b b b f
    b b b b b f
    b r  b-! b4-!
  }
  d'8\f
  \repeat tremolo 3 d,-! d( fis a)
  c( a fis) es4( d8)
  c'(\p a fis) es4( d8)

  c'( a fis) es4.(-!
  d8) r d[-! d]-! r4 \boxa
  g,8\p g' r8 r4.
  fis8( d) g-! a( c) h-!
  c,( c' h) a( d,) g-!
  r fis( g) d d'16( c h a)

  g8 g, r r4.
  fis'8( d) g-! a( c) h-!
  c,( c' h) a( d,) g-!
  fis( d) g-! d4( g8)
  d4( g8) d4( g8)
  r d' d, g[ g,] \boxb r
  g\p c cis d d, r


  fis'4.( g8) g, es''(\pp
  d) r es([ d])-! r4
  R2.*2
  \repeat tremolo 3 g,8-!\f fis16( g a fis) d8-!
  g4.( d
  g d)
  g4 h8 c4 c8

  d r4 d,4 g8
  r d d, g-! g' r
  g4.-! a4(\p g8)-!
  fis4 g8 d' d, r
  g4.-! a4( g8)-!
  \partial 8*5 c, r d-!\f <g, g'>4-! \bar "|."
}