va = \relative c'' {
  \voiceconsts

  \repeat volta 2 {
    \partial 4 h8. h16
    e4 e gis
    h,2 e8. e16
    dis4 dis fis

    a,2 a4
    gis4. a8 h4
    cis \grace h8 a4 gis
    gis8 fis r4 h

    h h h
    h2 h4
    h fis'8( dis) fis( dis)
    \grace dis cis2 cis4
    fis2 dis8. dis16
    e4 gis, ais
    h8.( cis16) h4
  }

  \repeat volta 2 {
    h
    h h h
    d h8( cis) d( cis)
    cis( h) h( a?) a( gis)
    \grace gis a2 a4

    a a a
    cis a8( h) cis( h)
    h( a) a( gis) gis( fis)
    \grace fis gis2 cis4

    c2 cis8. cis16
    a4 fis gis
    e8( dis) cis4\fermata e'8( cis)
    h4 h e

    dis2 e4
    gis, gis cis
    h2 e4 a,2 gis8. gis16

    fis4 h4. a8[
    a] gis4\fermata r8 h4
    e2 h8. h16
    \grace h8 a4 gis fis
    gis8.( e16 ) e4 \breathe
  }
}