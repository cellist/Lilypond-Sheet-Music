vb = \relative c'' {
  \voiceconsts

  \repeat volta 2 {
    \partial 4 gis8. gis16
    gis4 gis h
    gis2 gis8. gis16
    fis4 fis a

    fis2 fis4
    e4. fis8 gis4
    a \grace gis8 fis4 e
    e8 dis r4 dis

    dis8( e) fis( dis) e( fis)
    gis2 gis4
    fis dis'8( h) dis( h)
    \grace h ais2 ais4
    dis2 h8. h16
    gis4 e e
    dis8.( e16) dis4
  }

  \repeat volta 2 {
    gis
    gis gis gis
    h gis8( a?) h( a)
    a( gis) gis( fis) fis( eis)
    \grace eis fis2 fis4

    fis fis fis
    a fis8( gis) a( gis)
    gis( fis) fis( e) e( dis)
    \grace dis e2 gis4

    fis2 e8. e16
    fis4 fis dis
    cis cis\fermata cis'8( a)
    gis( a) h4 gis

    fis2 gis4
    e e a
    gis2 gis4
    fis2 e8. e16

    e4 dis4. fis8[
    fis] e4\fermata r8 gis4
    gis2 gis8. gis16
    \grace gis8 fis4 e dis
    e8.(\trill dis16) e4 \breathe
  }
}