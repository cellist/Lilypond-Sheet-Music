vb = \relative c' {
  \voiceconsts
  
  <d fis>4\mp <d fis> <d fis>
  \repeat unfold 3 <d fis>
  <d fis> <fis h> <fis h>
  \repeat unfold 3 <fis h>
  \repeat unfold 3 <g h>

  <gis h> <gis h> ais8( h)
  ais h ais cis h fis
  cis( d d cis) r4
  \repeat unfold 3 <d fis>4
  \repeat unfold 3 <d fis>

  <d g?> \repeat unfold 2 <d g>
  \repeat unfold 3 <e g>
  \repeat unfold 3 <e g>
  \repeat unfold 3 <e g>
  <cis g'> <cis fis> <d fis>

  <cis g'> <cis g'> <d g>
  <d g> <cis fis> <cis e>
  <cis e> <h d> <d g>
  <cis g'> <cis g'> <d fis>
  <cis g'> <cis g'> <d g>

  <d g> <cis fis> <cis fis>
  \repeat unfold 3 <d fis>
  d d d
  \repeat unfold 3 <h d>
  <h d> r <h d>\pp
  <h d> r2 \bar "|."
}