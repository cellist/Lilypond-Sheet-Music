va = \relative c' {
  \voiceconsts

  e8-1 c-4 g-4 e c e g c
  e-1 c a e c e a c
  f-2 c-4 a f-2 c f a c
  e c g e c e g c

  d h gis e h e gis h
  c a e c a c e a
  d a fis d a d fis a
  h g? d h g h d g
  h a fis a h dis-1 fis dis

  h-1 g e g h e g e
  a, g e g a e' g e
  a, fis d? fis a d-1 fis d
  h fis d h d fis h d
  b g d b d g-1 b-4 e-3

  a,-0 g e a, e' g a e'
  a, fis d a d fis a d,
  g, h? d g h g d h
  f? h d g h g d h
  e, h' d gis h gis d h

  a e a c e c a e
  f a d f a f d a
  g c e c g' c, e c
  g h d h g' h, d h
