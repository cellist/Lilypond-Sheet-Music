va = \relative c {
  \voiceconsts
  
  \repeat volta 2 {
    d4-4 fis-1 a-4
    d-2 d,-4 r
    a8.-1 h16-2 cis8.-1 d16-2 e8.-4 cis16-1
    d4-2 d, r
    e''8 d cis h a gis-4
    fis-2 e d cis h a
    d4 h e
    a, a' r
  }
  \repeat volta 2 {
    a, cis e

    a a, r
    e'8 fis g?-1 a-2 h-4 a-2
    a4-4 g fis
    cis8([-3 g'-2 a-0 g])-2 e'(-4 g,)-2
    d([-4 fis-1 a-0 fis])-1 d'(-2 h)-1
    a-0 g-4 fis e d cis
    cis2 d4
  }
  \repeat volta 2 {
    h' fis \mino d'8 h
    ais4.-1 h8-2 cis4-4

    cis-1 fis,-1 e'8-4 cis-1
    h4. cis8 d4
    fis4.-3 h,8-3 g'-4 fis-3
    e4.-2 ais,8-3 fis'-4 e-2
    d8.-4 cis16 h8[ d cis h]
    h2 ais4
  }
  \repeat volta 2 {
    ais-1 cis16(-4 h-2 ais-1 h)-2 cis4-4

    h-1 d16(-4 cis-3 h-1 cis)-3 d4
    ais8-1 fis-4 h-2 fis-4 cis'-4 fis,-4
    h-1 fis-3 cis'-3 fis,-3 d'4-4
    g-4 g g
    fis-3 e-1 d-4
    d8( cis) h4-1 \daca ais-1
    cis2-4 h4-2
  }
}