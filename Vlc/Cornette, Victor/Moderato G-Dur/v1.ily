va = \relative c {
  \voiceconsts

  \partial 4. d8 e fis
  g d a' d, h' d, d'4
  g,8 d a' d, h' d, d'4
  g,4. fis8 g a h cis
  d4 d, r8 a h cis

  d a e' a, fis' a, a'4
  d,8 a e' a, fis' a, a'4
  d,4. cis8 d dis e fis
  g4 g, r8 d''! h g
  e4 c'? r8 c a fis

  d4 h' r8 h g e
  c4 a' r8 fis e d
  g d a' d, h' d[ h g]
  e4 c' r8 c a fis
  d4 h' r8 h g e

  cis4 a' r8 h a g
  fis4. a8 g4. e8
  fis4. d8 cis4. e8
  a2 g4. e8
  fis4. d8 cis4. e8
  d2 r8 d e fis

  g d a' d, h' d, d'4
  g,8 d a' d, h' d, d'4
  g,4. fis8 g a h cis
  d4 d, r8 a h cis
  d a e' a, fis' a, a'4

  d,8 a e' a, fis' a, a'4
  d,4. cis8 d dis e fis
  g h d!4. d,8 e fis
  g h d4. d,8 e fis
  g4 g d h
  g2 r \bar "|."
}