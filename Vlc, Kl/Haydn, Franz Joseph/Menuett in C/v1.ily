va = \relative c {
  \voiceconsts
  
  \repeat volta 2 {
    c2.\p
    e
    e8( f e f) a-. r
    e( f e f) a-. r
    a2.

    h
    h8 c h c e-. r
    h c h c e-. r
  }
  
  \repeat volta 2 {
    g,4-.\p\cresc g-. g-.
    fis8( g fis g) fis(\! g)

    a4-.\mf d-. h-.
    h8( c h c) h( c)
    d4\cresc a f?

    e8( f g a) h( c)
    d( e f d) h( g)
    c4\f r2
  }
}