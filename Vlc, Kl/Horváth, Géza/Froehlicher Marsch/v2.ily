vb = \relative c' {
  \voiceconsts
  \clef "treble"

  << { fis4 \tuplet 3/2 { e8( fis g) } } \\ { d4 cis } >>
  <d a'>-. <cis g'>-.
  <d fis>-. <cis e>-.
  d2
  g4 fis
  <gis d'>-. <a cis>-.
  <gis h>-. <e gis>-.
  <e a>2
  << { fis4 \tuplet 3/2 { e8( fis g?) } } \\ { d4 cis } >>
  <d a'>-. <cis g'>-.

  <d fis>-. <cis e>-.
  <h d>2
  <d fis a>4 \tuplet 3/2 4 { d8( e fis) }
  <dis a'>4-. <e g>-.
  <cis fis>-. <cis e>-.
  d2
  e4 \tuplet 3/2 4 { fis8( d fis) }
  e4 fis
  g fis8.( d16)
  e2

  e4 \tuplet 3/2 4 { fis8( d fis) }
  e4 fis
  g fis8.( d16)
  e2
  <a d>4 \tuplet 3/2 4 { <g cis>8 g <g h> }
  <fis a>4 <d fis>

  <cis g'> <cis fis>8.( e16)
  <d a'>2
  <h' d>4 \tuplet 3/2 4 { <g cis>8 g <g h> }
  <fis a>4 <h, d>8( <h g'>)
  <cis fis>4 <cis e>
  d2 \bar "|."
}