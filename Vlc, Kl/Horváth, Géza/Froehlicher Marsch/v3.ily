vc = \relative c' {
  \voiceconsts

  a4( g)
  fis-. e-.
  <d a'>-. <a g'>-.
  <d fis>2
  d'4 d8( h)
  e4-. <a, e'>-.
  <e d'>-. <e d'>-.
  <a cis>2
  a4( g)
  fis-. e-.

  <d a'>-. <a g'>-.
  <h fis'>2
  r4 << a' \\ \tuplet 3/2 4 { fis8( e d) } >>
  <h fis' h>4-. <e h'>-.
  <a, a'>-. <a g'>-.
  <d fis>2
  a'4 \tuplet 3/2 4 { d8( fis, d') }
  a4 d
  e d8.( fis,16)
  a2

  a4 \tuplet 3/2 4 { d8( fis, d') }
  a4 d
  e d8.( fis,16)
  a2
  fis'4 e8( d)
  d4 a

  <e a> << { a8.( g16) } \\ a,4 >>
  <d fis>2
  <g g'>4 e'8( d)
  d4 g,8( e)
  <a, a'>4 <a g'>
  <d fis>2 \bar "|."
}