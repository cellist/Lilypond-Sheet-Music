vc = \relative c {
  \voiceconsts

  << {
    f2 e4 f
    b4. f8 f2
    a f4 f
    e1

    f2 e4 f
    b4. f8 f2
    f4 a g b
    a1

    a2 b4 a
    a4. c8 a2
    a b4 a
    g4. f8 e2

    f e4 f
    b4. f8 f2
    f4 a g b
    a1
  } \\ {
    f2 c4 d
    b4. b8 b2
    f a4 f
    c'1

    f2 c4 d
    b4. b8 b2
    c c4 c
    f,1

    f'2 f4 f
    f4. f8 f2
    f b,4 f'
    e2 c

    f c4 d
    b4. b8 b2
    c c4 c
    f,1
  } >>
  \bar "|."
}