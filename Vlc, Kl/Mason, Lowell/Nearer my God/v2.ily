vb = \relative c' {
  \voiceconsts
  \clef "treble"

  <c a'>2 <b g'>4 <a f'>
  <d f>4. <b d>8 <b d>2
  c <c f>4 <c a'>
  <c g'>1

  <c a'>2 <b g'>4 <a f'>
  <d f>4. <b d>8 <b d>2
  <a c>4 <c f> <c e> <c g'>
  <c f>1

  <f c'>2 <f d'>4 <f c'>
  <f c'>4. <f a>8 <f c'>2
  <f c'> <f d'>4 <f c'>
  <g c>4. <c, a'>8 <c g'>2

  <c a'> <b g'>4 <a f'>
  <d f>4. <b d>8 <b d>2
  <a c>4 <c f> <c e> <c g'>
  <c f>1 \bar "|."
}