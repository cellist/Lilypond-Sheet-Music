vb = \relative c'' {
  \voiceconsts
  \clef "treble"

  \partial 4 g8 g
  c c e g a4 g8 e
  d2 c4 r \boxa
  <c, e g>2 <c e g>
  <d f a> <d f a>4 <h d g>
  <c e g> <c a'> <c g'> <c e g>

  <c a'>2 <c g'>
  a'4 a8 g <e g>2
  <f a>4. <e g>8 <f a>4 <h, d g>
  <c e g>2 <c f>4 <c g'>
  << <d g>2 \\ { c4( h) } >> <c e g> r \boxb

  r <c e g> r <c e g>
  r <c f a> r <h d g>
  r <c e g> r <c e g>
  r <c a'> r <c g'>

  a' a8 g <e g>2
  <f a>4. <e g>8 <f a>4 <h, d g>
  <c e g>2 <c f>4 <c g'>
  \partial 2. << <d g>2 \\ { c4( h) } >> <c e g> \bar "|."
}