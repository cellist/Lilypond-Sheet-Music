vc = \relative c' {
  \voiceconsts

  \partial 4 r4
  << {
    <e g>2 <f a>4( <e g>)
    <d g>2 <e g>4
  } \\ {
    c2 c
    c4( h) c
  } >> r4 \boxa
  c,2 c
  f f4 g
  c, f e c8 e

  f2 e
  f4 f8 e c2
  d4. e8 f4 g
  c, c8 e f4 e
  f g c, r \boxb

  c r c r
  f r g r
  c, r c r
  f r e r

  f f8 e c2
  d4. e8 f4 g
  c, c8 e f4 e
  \partial 2. f g c, \bar "|."
}