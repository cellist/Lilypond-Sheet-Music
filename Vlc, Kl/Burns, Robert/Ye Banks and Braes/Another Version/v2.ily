vb = \relative c'' {
  \voiceconsts
  \clef "treble"

  <g e'>4. <f d'>8 <e c'>4
  << { c'( a) g } \\ f2. >>
  g4( a) <f a c>
  <e g c>2 r4 \boxa
  <e g>2 <e g>4
  << { h'( a) } \\ d,2 >> h'4
  <e, c'>2 <e c'>4
  << { h'( a) } \\ d,2 >> h'4
  <e, c'>4. f8 <e g>4

  <f a>2.
  g
  <d h'>2 g8( f)
  <e g>2 <e g>4
  << { h'( a) } \\ d,2 >> h'4
  <e, c'>2 <e c'>4
  << { h'( a) } \\ d,2 >> h'4
  <e, c'>4. f8 <e g>4
  <f a>2.

  <d f>2 <f a>4
  <e g>2 r4 \boxb
  <c e g>2 <c f a>4
  <c e g>2.
  <c e g>2 <c f a>4
  <c e g>2.
  <c e g>
  <c e g>
  << { a'4.( g8) } \\ d2 >> <d a'>4

  <h d g>2 <h g'>4
  <e g>2 <e g>4
  << { h'( a) } \\ d,2 >> h'4
  <e, c'>2 <e c'>4
  << { h'( a) } \\ d,2 >> h'4
  <e, c'>4. f8 <e g>4
  <f a>2.
  <d f>2 <f a>4
  <e g>2 r4 \bar "|."
}