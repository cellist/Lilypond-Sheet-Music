vb = \relative c'' {
  \voiceconsts
  \clef "treble"
  
  << {
    g2 g4 f
    es2 b'
    c4 b b as
    g1
    g2 as4 b
    c2 b

    as4 f g a
    b1
    g2 g4 f
    es2 b'
    b4 as? as g

    f1
    f2 g4 as
    g f es as
    g2 f
    es1
  } \\ {
    es2 d4 d
    es2 es
    es4 d es f
    es1
    es2 es4 es
    es2 es

    es4 f es es
    d1
    es2 d4 d
    es2 es
    es4 es e e

    s1
    d2 es?4 d
    es d es f
    es2 d
    b1
  } >>
  \bar "|."
}