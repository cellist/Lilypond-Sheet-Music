vc = \relative c' {
  \voiceconsts

  << {
    b2 b4 as
    g2 es
    c4 b' b b
    b1
    b2 as4 g
    as2 g

    c4 b b es,
    f1
    g4 as b as
    g2 es4 d
    c' c8 c c4 b

    as1
    b2 b4 b
    b g g c
    b!2. as4
    g1
  } \\ {
    es2 b4 b
    c2 g
    as4 b c d
    es1
    es4 d c b
    as2 es'

    f4 d es c
    b1
    es2 b4 b
    c2 g
    as4. b8 c4 c

    f1
    as2 g4 f
    es h c as
    b!2 b
    es1
  } >>
  \bar "|."
}