vb = \relative c' {
  \voiceconsts
  \clef "treble"
  
  \partial 2. <es g>4 <d f> <es g>
  <d as'>2. <es g>4
  <d f> <es g> <c es>4. <d f>8
  <d f>4 <es g>2.~
  <es g>4 <es g> <d f> <es g>
  <d as'>2. <es g>4

  <d f> <es g> <c es>4. <d f>8
  <es g>1~
  <es g>4 <es b'> <es b'> <es b'>
  <es c'>2. <es g>4
  <es g> <es b'> <es b'>4. <d f>8
  <d f>4 <f as>2.~
  <f as>4 <f as> <e g> f

  <es! g>2. es4
  es <es f> <d f>4. <d g>8
  <d g>1~
  <d g>4 <g b> <es b'> <es b'>
  <es c'>2. <es g>4

  <es g> <es b'> <es b'>4. <d f>8
  <d f>4 <f as>2.~
  <f as>4 <f as> <e g> f
  <es! g>2. <b es>4
  es <es f> <d f>4. es8
  es1~
  \partial 4 es4 \bar "|."
}