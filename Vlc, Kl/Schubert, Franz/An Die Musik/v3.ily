vc = \relative c {
  \voiceconsts

  r4 a( d) d-.
  fis,2-> a4-.
  a,-.
  \repeat volta 2 {
    d r r2

    r4 fis( h) gis-.
    a r a r
    d-. a( d) d-.

    fis,2( g?)
    a4( ais h2)
    cis( d)

    a?4( a' gis g)
    fis( d cis a)
    d( a8 a' gis4 g)
    fis( d cis4. a8)

    d2( e4 fis)
    g2( gis)
    a( ais)

    h( gis)
    a?( a,)
    d4 r r2

    <g,, g'> r8 g'-. h-. cis-.
    <d, d'>2 r8 d'-. e-. fis-.
    <g, g'>2-> a->
  }
  <d, d'>2.-> r4 \bar "|."
}