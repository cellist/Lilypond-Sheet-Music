vb = \relative c' {
  \voiceconsts
  \clef "treble"

  \partial 4 <h e g>4
  <h e g> <h e> <h dis>
  <h e>2 <h f'>4
  << {
    e2 <dis a'>8( <e g>
    <h dis fis>2)
  } \\ {
    e8.( d16 c8) h~ h4
    s2
  } >> <h e g>4
  <h e g> <h e> <h dis>
  <h e>2 <h f'>4

  << {
    e2 <dis a'>8( <e g>
    <h dis fis>2)
  } \\ {
    e8.( d16 c8) h~ h4
    s2
  } >> <h dis>4
  <h e> <h e> <d! fis>
  <d g> << { g d'8( g,) } \\ d2 >>
  <e g>4 <e g> <e a>
  << { h' fis'8( h,) c( h) } \\ { dis,2 <c e>4 } >>

  <h e h'> <c e a>8 <cis e g> <dis fis>4
  <h e g> r8 <f' gis>4-> <f gis>8
  <e a>8. <d! e>16 <c e>8 <e a> <e g!>( <dis fis>)
  <h e>2 r4
  <h dis>4.. <h dis>16 <h dis>4
  <h e>4.. <h e>16 <h e>4

  <d fis>4.. <d fis>16 <d fis>4
  <d g>4.. <d g>16 <d g>4
  <cis e g>4.. <cis e g>16 <cis e g>4
  << {
    c' a8 fis <h, e h'> <c e>
    <e g>2( g8) fis
  } \\ {
    <c dis>4. <c dis>8 s4
    h8 ais h4 <a dis>
  } >>
  \partial 2 <g e'>2\fermata \bar "|."
}