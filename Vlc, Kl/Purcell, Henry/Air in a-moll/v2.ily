vb = \relative c' {
  \voiceconsts
  \clef "treble"

  <c e>2 <c a'>4
  <h d>2 <h gis'>4
  <c e>2 <c a'>4
  <h gis'>2.
  <e a>2 <c e>4
  <h d>2 <h gis'>4
  <c a'> <f a> <d h'>

  <c a'>2.
  <e g?>2 <e c'>4
  <d h'>2 <e c'>4
  <c e> <h gis'>
  <cis a'>
  <d a'> <d f> <c! a'>

  <d f>2 <d h'>4
  <c e>2 <c a'>4
  <h d> <h f'> <h gis'>
  <c a'>2. \bar "|."
}