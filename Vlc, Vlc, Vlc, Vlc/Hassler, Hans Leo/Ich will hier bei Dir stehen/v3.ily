vc = \relative c' {
  \voiceconsts

  \partial 4 b4
  as g g8( f) b4
  as( b) b\fermata h
  c b h h

  g2. b!4
  as g g8( f) b4
  as( b) b\fermata h
  c b h h

  g2. b!4
  as g as8( b) c4
  c2 c4\fermata g
  ges g f f

  g2.\fermata a4
  b d des as!
  b( as) as\fermata b
  c d? es d
