va = \relative c'' {
  \voiceconsts
  \clef "treble"

  \repeat volta 2 {
    d2. c4
    b2 d
    d d
    c2. b4
    a2 c
    c c

    b2. a4
    g2 d'
    c b
    a1
    a
    g4 a b c
    d1~
    d2 d
    d d

    c2. b4
    a2 c
    c c
    b e4 d
    c b a g
    a1
    g g
  }
  \repeat volta 2 {
    r2 e
    e e
    e2. d4
    e f g2~
    g f
    g1
  }
}