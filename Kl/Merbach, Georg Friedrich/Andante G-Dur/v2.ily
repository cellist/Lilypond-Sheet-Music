vb = \relative c {
  \voiceconsts
  \clef "bass"

  c4 c' h g
  c fis, g g,
  fis' fis e e
  fis g c,2 \bar "||"
  <c' e> <h d>
  <a c> <g h>

  <fis a> <e g>
  fis4 g <c, e>2 \bar "||"
  c'8 d e fis g fis g g,
  a h c d e d e e,
  fis g a h c h c c,
  fis4 g c, c, \bar "||"
  c'2 h

  a g
  fis8 g a h c d e c
  fis d g g, c4 c,\fermata \bar "|."
}