va = \relative c'' {
  \voiceconsts

  f8 c16 a f8[ f f f]
  g16 f e f e4 e'16 d e f
  g8 e16 c g8[ b b b]
  c16 b a b a4 r8 c
  d16 b a b f b a b d4
  c16 a g a f a g a c4

  c16 b a b g' f e d c b a g
  b a g a f' e d c b a g f
  g4. d'16 c b a g fis
  g4. g16 b b d d g
  <a, f'?>4( <g e'>8) \grace h16 c8[-. \grace h16 c8-. \grace h16 c8]-.
  \grace d16 c h c d <a c>4 r

  << { \grace c16 b! a b c b4 } \\ { g g } >> r
  << { \grace b16 a g a b a4~ a16 f' f a, } \\ { f4 f~ f16 a a f } >>
  <f a>4 <e g> r16 c' d e
  f g a f c4 r16 c d e
  f g a f c8 es es16 d d cis
  d e! f d b8 b' b16 a a gis

  << { a2 a16 b h c } \\ { f,2 f4 } >>
  <g b!>2 b16 g g e
  f8 c d g \grace f16 e8 d16 c
  f c g' c, a' c, b' c, c'8-. r
  r4 r b16 g g e
  f c a f f' c a f <g e'>4
  \grace <g e'>8 <a f'>2 r4 \bar "|."
}