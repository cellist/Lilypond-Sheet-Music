vb = \relative c {
  \voiceconsts
  \clef "bass"

  f8[ a f a f a]
  g[ b g b g b]
  e,[ c' e, c' e, c']
  f,[ c' f, c' f, a]
  b4 b, r16 f' d b
  f'4 f, r16 c'' a f

  g4 e r8 e
  f4 a, r8 a
  b16 d g d b4. c8
  b16 d g d b4. h8
  c16 h c h c4 r
  r r8 c' a16 c a f

  c4 r8 c' g16 c g e
  c4 r8 <c c'>[ <c c'> <h h'>]
  c' a16 f c8[ c'(-. c)-. <b! c>]
  <a c> f c'[ c, c' <b c>]
  <a c> f a c c16 b b a
  b4~ b8 d d16 c c h

  c c, d e f g a b! c4~
  c16 c, d e f g a b c4
  r16 f, a f b a b g c8 b
  a[-. e-. f-. g]-. a-. r
  a16 c a f a c a f c'8 c,
  f4 r c16 e g b
  \grace b8 <f c'>2 r4 \bar "|."
}